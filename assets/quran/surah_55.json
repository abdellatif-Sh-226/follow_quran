    "page": 531
  },
  {
    "surah": "Ar-Rahmaan",
    "ayah": 5,
    "text": "ٱلشمس وٱلقمر بحسبانࣲ",
    "page": 531
  },
  {
    "surah": "Ar-Rahmaan",
    "ayah": 6,
    "text": "وٱلنجم وٱلشجر یسجدان",
    "page": 531
  },
  {
    "surah": "Ar-Rahmaan",
    "ayah": 7,
    "text": "وٱلسماء رفعها ووضع ٱلمیزان",
    "page": 531
  },
  {
    "surah": "Ar-Rahmaan",
    "ayah": 8,
    "text": "ألا تطغوا فی ٱلمیزان",
    "page": 531
  },
  {
    "surah": "Ar-Rahmaan",
    "ayah": 9,
    "text": "وأقیموا ٱلوزن بٱلقسط ولا تخسروا ٱلمیزان",
    "page": 531
  },
  {
    "surah": "Ar-Rahmaan",
    "ayah": 10,
    "text": "وٱلأرض وضعها للأنام",
    "page": 531
  },
  {
    "surah": "Ar-Rahmaan",
    "ayah": 11,
    "text": "فیها فـكهة وٱلنخل ذات ٱلأكمام",
    "page": 531
  },
  {
    "surah": "Ar-Rahmaan",
    "ayah": 12,
    "text": "وٱلحب ذو ٱلعصف وٱلریحان",
    "page": 531
  },
  {
    "surah": "Ar-Rahmaan",
    "ayah": 13,
    "text": "فبأی ءالاء ربكما تكذبان",
    "page": 531
  },
  {
    "surah": "Ar-Rahmaan",
    "ayah": 14,
    "text": "خلق ٱلإنسـن من صلصـلࣲ كٱلفخار",
    "page": 531
  },
  {
    "surah": "Ar-Rahmaan",
    "ayah": 15,
    "text": "وخلق ٱلجان من مارجࣲ من نارࣲ",
    "page": 531
  },
  {
    "surah": "Ar-Rahmaan",
    "ayah": 16,
    "text": "فبأی ءالاء ربكما تكذبان",
    "page": 531
  },
  {
    "surah": "Ar-Rahmaan",
    "ayah": 17,
    "text": "رب ٱلمشرقین ورب ٱلمغربین",
