  },
  {
    "surah": "Al-Inshiqaaq",
    "ayah": 4,
    "text": "وألقت ما فیها وتخلت",
    "page": 589
  },
  {
    "surah": "Al-Inshiqaaq",
    "ayah": 5,
    "text": "وأذنت لربها وحقت",
    "page": 589
  },
  {
    "surah": "Al-Inshiqaaq",
    "ayah": 6,
    "text": "یـأیها ٱلإنسـن إنك كادح إلى ربك كدحا فملـقیه",
    "page": 589
  },
  {
    "surah": "Al-Inshiqaaq",
    "ayah": 7,
    "text": "فأما من أوتی كتـبه بیمینهۦ",
    "page": 589
  },
  {
    "surah": "Al-Inshiqaaq",
    "ayah": 8,
    "text": "فسوف یحاسب حسابا یسیرا",
    "page": 589
  },
  {
    "surah": "Al-Inshiqaaq",
    "ayah": 9,
    "text": "وینقلب إلى أهلهۦ مسرورا",
    "page": 589
  },
  {
    "surah": "Al-Inshiqaaq",
    "ayah": 10,
    "text": "وأما من أوتی كتـبه وراء ظهرهۦ",
    "page": 589
  },
  {
    "surah": "Al-Inshiqaaq",
    "ayah": 11,
    "text": "فسوف یدعوا ثبورا",
    "page": 589
  },
  {
    "surah": "Al-Inshiqaaq",
    "ayah": 12,
    "text": "ویصلى سعیرا",
    "page": 589
  },
  {
    "surah": "Al-Inshiqaaq",
    "ayah": 13,
    "text": "إنه كان فی أهلهۦ مسرورا",
    "page": 589
  },
  {
    "surah": "Al-Inshiqaaq",
    "ayah": 14,
    "text": "إنه ظن أن لن یحور",
    "page": 589
  },
  {
    "surah": "Al-Inshiqaaq",
    "ayah": 15,
    "text": "بلى إن ربه كان بهۦ بصیرا",
    "page": 589
  },
  {
    "surah": "Al-Inshiqaaq",
    "ayah": 16,
    "text": "فلا أقسم بٱلشفق",
    "page": 589
  },
  {
    "surah": "Al-Inshiqaaq",
    "ayah": 17,
    "text": "وٱلیل وما وسق",
    "page": 589
  },
  {
    "surah": "Al-Inshiqaaq",
    "ayah": 18,
    "text": "وٱلقمر إذا ٱتسق",
    "page": 589
  },
  {
    "surah": "Al-Inshiqaaq",
    "ayah": 19,
    "text": "لتركبن طبقا عن طبقࣲ",
    "page": 589
  },
  {
    "surah": "Al-Inshiqaaq",
    "ayah": 20,
    "text": "فما لهم لا یؤمنون",
    "page": 589
  },
  {
    "surah": "Al-Inshiqaaq",
    "ayah": 21,
    "text": "وإذا قرئ علیهم ٱلقرءان لا یسجدون ۩",
    "page": 589
  },
  {
    "surah": "Al-Inshiqaaq",
    "ayah": 22,
    "text": "بل ٱلذین كفروا یكذبون",
    "page": 589
  },
  {
    "surah": "Al-Inshiqaaq",
    "ayah": 23,
    "text": "وٱلله أعلم بما یوعون",
    "page": 589
  },
  {
    "surah": "Al-Inshiqaaq",
    "ayah": 24,
    "text": "فبشرهم بعذاب ألیم",
    "page": 589
  },
  {
    "surah": "Al-Inshiqaaq",
    "ayah": 25,
    "text": "إلا ٱلذین ءامنوا وعملوا ٱلصـلحـت لهم أجر غیر ممنونۭ",
    "page": 589
  }
]