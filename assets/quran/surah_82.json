  {
    "surah": "Al-Infitaar",
    "ayah": 3,
    "text": "وإذا ٱلبحار فجرت",
    "page": 587
  },
  {
    "surah": "Al-Infitaar",
    "ayah": 4,
    "text": "وإذا ٱلقبور بعثرت",
    "page": 587
  },
  {
    "surah": "Al-Infitaar",
