    "text": "علمت نفس ما قدمت وأخرت",
    "page": 587
  },
  {
    "surah": "Al-Infitaar",
    "ayah": 6,
    "text": "یـأیها ٱلإنسـن ما غرك بربك ٱلكریم",
    "page": 587
  },
  {
    "surah": "Al-Infitaar",
    "ayah": 7,
    "text": "ٱلذی خلقك فسوىك فعدلك",
    "page": 587
  },
  {
    "surah": "Al-Infitaar",
    "ayah": 8,
    "text": "فی أی صورةࣲ ما شاء ركبك",
    "page": 587
  },
  {
    "surah": "Al-Infitaar",
    "ayah": 9,
    "text": "كلا بل تكذبون بٱلدین",
    "page": 587
  },
  {
    "surah": "Al-Infitaar",
    "ayah": 10,
    "text": "وإن علیكم لحـفظین",
    "page": 587
  },
  {
    "surah": "Al-Infitaar",
    "ayah": 11,
    "text": "كراما كـتبین",
    "page": 587
  },
  {
    "surah": "Al-Infitaar",
    "ayah": 12,
    "text": "یعلمون ما تفعلون",
    "page": 587
  },
  {
    "surah": "Al-Infitaar",
    "ayah": 13,
    "text": "إن ٱلأبرار لفی نعیمࣲ",
    "page": 587
  },
  {
    "surah": "Al-Infitaar",
    "ayah": 14,
    "text": "وإن ٱلفجار لفی جحیمࣲ",
