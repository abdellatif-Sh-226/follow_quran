    "page": 587
  },
  {
    "surah": "Al-Infitaar",
    "ayah": 19,
    "text": "یوم لا تملك نفس لنفسࣲ شیـٔا وٱلأمر یومىٕذࣲ لله",
    "page": 587
  }
]