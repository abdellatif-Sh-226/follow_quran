[
  {
    "surah": "Abasa",
    "ayah": 1,
    "text": "بسم ٱلله ٱلرحمـن ٱلرحیم عبس وتولى",
    "page": 585
  },
  {
    "surah": "Abasa",
    "ayah": 2,
    "text": "أن جاءه ٱلأعمى",
    "page": 585
  },
  {
    "surah": "Abasa",
    "ayah": 3,
    "text": "وما یدریك لعله یزكى",
    "page": 585
  },
  {
    "surah": "Abasa",
    "ayah": 4,
    "text": "أو یذكر فتنفعه ٱلذكرى",
    "page": 585
  },
  {
    "surah": "Abasa",
    "ayah": 5,
    "text": "أما من ٱستغنى",
    "page": 585
  },
  {
    "surah": "Abasa",
    "ayah": 6,
    "text": "فأنت له تصدى",
    "page": 585
  },
  {
    "surah": "Abasa",
    "ayah": 7,
    "text": "وما علیك ألا یزكى",
    "page": 585
  },
  {
    "surah": "Abasa",
    "ayah": 8,
    "text": "وأما من جاءك یسعى",
    "page": 585
  },
  {
    "surah": "Abasa",
    "ayah": 9,
    "text": "وهو یخشى",
    "page": 585
  },
  {
    "surah": "Abasa",
    "ayah": 10,
    "text": "فأنت عنه تلهى",
    "page": 585
  },
  {
    "surah": "Abasa",
    "ayah": 11,
    "text": "كلا إنها تذكرة",
    "page": 585
  },
  {
    "surah": "Abasa",
    "ayah": 12,
    "text": "فمن شاء ذكره",
    "page": 585
  },
  {
    "surah": "Abasa",
    "ayah": 13,
    "text": "فی صحفࣲ مكرمةࣲ",
    "page": 585
  },
  {
    "surah": "Abasa",
    "ayah": 14,
    "text": "مرفوعةࣲ مطهرةۭ",
    "page": 585
  },
  {
    "surah": "Abasa",
    "ayah": 15,
    "text": "بأیدی سفرةࣲ",
    "page": 585
  },
  {
    "surah": "Abasa",
    "ayah": 16,
    "text": "كرامۭ بررةࣲ",
    "page": 585
  },
  {
    "surah": "Abasa",
    "ayah": 17,
    "text": "قتل ٱلإنسـن ما أكفره",
    "page": 585
  },
  {
    "surah": "Abasa",
    "ayah": 18,
    "text": "من أی شیء خلقه",
    "page": 585
  },
  {
    "surah": "Abasa",
    "ayah": 19,
    "text": "من نطفة خلقه فقدره",
    "page": 585
  },
  {
    "surah": "Abasa",
    "ayah": 20,
    "text": "ثم ٱلسبیل یسره",
    "page": 585
  },
  {
    "surah": "Abasa",
    "ayah": 21,
    "text": "ثم أماته فأقبره",
    "page": 585
  },
  {
    "surah": "Abasa",
    "ayah": 22,
    "text": "ثم إذا شاء أنشره",
    "page": 585
  },
  {
    "surah": "Abasa",
    "ayah": 23,
    "text": "كلا لما یقض ما أمره",
    "page": 585
  },
  {
    "surah": "Abasa",
    "ayah": 24,
    "text": "فلینظر ٱلإنسـن إلى طعامهۦ",
    "page": 585
  },
  {
    "surah": "Abasa",
    "ayah": 25,
    "text": "أنا صببنا ٱلماء صبا",
    "page": 585
  },
  {
    "surah": "Abasa",
    "ayah": 26,
    "text": "ثم شققنا ٱلأرض شقا",
    "page": 585
  },
  {
    "surah": "Abasa",
    "ayah": 27,
    "text": "فأنبتنا فیها حبا",
    "page": 585
  },
  {
    "surah": "Abasa",
    "ayah": 28,
    "text": "وعنبا وقضبا",
    "page": 585
  },
  {
    "surah": "Abasa",
    "ayah": 29,
    "text": "وزیتونا ونخلا",
    "page": 585
  },
  {
    "surah": "Abasa",
    "ayah": 30,
    "text": "وحداىٕق غلبا",
    "page": 585
  },
  {
    "surah": "Abasa",
    "ayah": 31,
    "text": "وفـكهة وأبا",
    "page": 585
  },
  {
    "surah": "Abasa",
    "ayah": 32,
    "text": "متـعا لكم ولأنعـمكم",
    "page": 585
  },
  {
    "surah": "Abasa",
    "ayah": 33,
    "text": "فإذا جاءت ٱلصاخة",
    "page": 585
  },
  {
    "surah": "Abasa",
    "ayah": 34,
    "text": "یوم یفر ٱلمرء من أخیه",
    "page": 585
  },
  {
    "surah": "Abasa",
    "ayah": 35,
    "text": "وأمهۦ وأبیه",
    "page": 585
  },
  {
    "surah": "Abasa",
    "ayah": 36,
    "text": "وصـحبتهۦ وبنیه",
    "page": 585
  },
  {
    "surah": "Abasa",
    "ayah": 37,
    "text": "لكل ٱمرئࣲ منهم یومىٕذࣲ شأن یغنیه",
    "page": 585
  },
  {
    "surah": "Abasa",
    "ayah": 38,
    "text": "وجوه یومىٕذࣲ مسفرة",
    "page": 585
  },
  {
    "surah": "Abasa",
    "ayah": 39,
    "text": "ضاحكة مستبشرة",
    "page": 585
  },
  {
    "surah": "Abasa",
    "ayah": 40,
    "text": "ووجوه یومىٕذ علیها غبرة",
    "page": 585
  },
  {
    "surah": "Abasa",
    "ayah": 41,
    "text": "ترهقها قترة",
    "page": 585
  },
  {
    "surah": "Abasa",
    "ayah": 42,
    "text": "أولـىٕك هم ٱلكفرة ٱلفجرة",
    "page": 585
  }
]