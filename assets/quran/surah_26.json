  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 113,
    "text": "إن حسابهم إلا على ربی لو تشعرون",
    "page": 372
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 114,
    "text": "وما أنا۠ بطارد ٱلمؤمنین",
    "page": 372
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 115,
    "text": "إن أنا۠ إلا نذیر مبین",
    "page": 372
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 116,
    "text": "قالوا لىٕن لم تنته یـنوح لتكونن من ٱلمرجومین",
    "page": 372
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 117,
    "text": "قال رب إن قومی كذبون",
    "page": 372
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 118,
    "text": "فٱفتح بینی وبینهم فتحا ونجنی ومن معی من ٱلمؤمنین",
    "page": 372
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 119,
    "text": "فأنجینـه ومن معه فی ٱلفلك ٱلمشحون",
    "page": 372
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 120,
    "text": "ثم أغرقنا بعد ٱلباقین",
    "page": 372
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 121,
    "text": "إن فی ذ ⁠لك لـٔایة وما كان أكثرهم مؤمنین",
    "page": 372
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 122,
    "text": "وإن ربك لهو ٱلعزیز ٱلرحیم",
    "page": 372
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 123,
    "text": "كذبت عاد ٱلمرسلین",
    "page": 372
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 124,
    "text": "إذ قال لهم أخوهم هود ألا تتقون",
    "page": 372
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 125,
    "text": "إنی لكم رسول أمین",
    "page": 372
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 126,
    "text": "فٱتقوا ٱلله وأطیعون",
    "page": 372
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 127,
    "text": "وما أسـٔلكم علیه من أجر إن أجری إلا على رب ٱلعـلمین",
    "page": 372
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 128,
    "text": "أتبنون بكل ریع ءایة تعبثون",
    "page": 372
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 129,
    "text": "وتتخذون مصانع لعلكم تخلدون",
    "page": 372
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 130,
    "text": "وإذا بطشتم بطشتم جبارین",
    "page": 372
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 131,
    "text": "فٱتقوا ٱلله وأطیعون",
    "page": 372
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 132,
    "text": "وٱتقوا ٱلذی أمدكم بما تعلمون",
    "page": 372
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 133,
    "text": "أمدكم بأنعـمࣲ وبنین",
    "page": 372
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 134,
    "text": "وجنـتࣲ وعیون",
    "page": 372
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 135,
    "text": "إنی أخاف علیكم عذاب یوم عظیمࣲ",
    "page": 372
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 136,
    "text": "قالوا سواء علینا أوعظت أم لم تكن من ٱلو ⁠عظین",
    "page": 372
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 137,
    "text": "إن هـذا إلا خلق ٱلأولین",
    "page": 373
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 138,
    "text": "وما نحن بمعذبین",
    "page": 373
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 139,
    "text": "فكذبوه فأهلكنـهم إن فی ذ ⁠لك لـٔایة وما كان أكثرهم مؤمنین",
    "page": 373
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 140,
    "text": "وإن ربك لهو ٱلعزیز ٱلرحیم",
    "page": 373
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 141,
    "text": "كذبت ثمود ٱلمرسلین",
    "page": 373
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 142,
    "text": "إذ قال لهم أخوهم صـلح ألا تتقون",
    "page": 373
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 143,
    "text": "إنی لكم رسول أمین",
    "page": 373
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 144,
    "text": "فٱتقوا ٱلله وأطیعون",
    "page": 373
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 145,
    "text": "وما أسـٔلكم علیه من أجر إن أجری إلا على رب ٱلعـلمین",
    "page": 373
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 146,
    "text": "أتتركون فی ما هـهنا ءامنین",
    "page": 373
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 147,
    "text": "فی جنـتࣲ وعیونࣲ",
    "page": 373
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 148,
    "text": "وزروعࣲ ونخلࣲ طلعها هضیم",
    "page": 373
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 149,
    "text": "وتنحتون من ٱلجبال بیوتا فـرهین",
    "page": 373
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 150,
    "text": "فٱتقوا ٱلله وأطیعون",
    "page": 373
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 151,
    "text": "ولا تطیعوا أمر ٱلمسرفین",
    "page": 373
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 152,
    "text": "ٱلذین یفسدون فی ٱلأرض ولا یصلحون",
    "page": 373
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 153,
    "text": "قالوا إنما أنت من ٱلمسحرین",
    "page": 373
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 154,
    "text": "ما أنت إلا بشر مثلنا فأت بـٔایة إن كنت من ٱلصـدقین",
    "page": 373
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 155,
    "text": "قال هـذهۦ ناقة لها شرب ولكم شرب یومࣲ معلومࣲ",
    "page": 373
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 156,
    "text": "ولا تمسوها بسوءࣲ فیأخذكم عذاب یوم عظیمࣲ",
    "page": 373
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 157,
    "text": "فعقروها فأصبحوا نـدمین",
    "page": 373
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 158,
    "text": "فأخذهم ٱلعذاب إن فی ذ ⁠لك لـٔایة وما كان أكثرهم مؤمنین",
    "page": 373
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 159,
    "text": "وإن ربك لهو ٱلعزیز ٱلرحیم",
    "page": 373
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 160,
    "text": "كذبت قوم لوط ٱلمرسلین",
    "page": 374
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 161,
    "text": "إذ قال لهم أخوهم لوط ألا تتقون",
    "page": 374
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 162,
    "text": "إنی لكم رسول أمین",
    "page": 374
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 163,
    "text": "فٱتقوا ٱلله وأطیعون",
    "page": 374
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 164,
    "text": "وما أسـٔلكم علیه من أجر إن أجری إلا على رب ٱلعـلمین",
    "page": 374
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 165,
    "text": "أتأتون ٱلذكران من ٱلعـلمین",
    "page": 374
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 166,
    "text": "وتذرون ما خلق لكم ربكم من أزو ⁠جكم بل أنتم قوم عادون",
    "page": 374
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 167,
    "text": "قالوا لىٕن لم تنته یـلوط لتكونن من ٱلمخرجین",
    "page": 374
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 168,
    "text": "قال إنی لعملكم من ٱلقالین",
    "page": 374
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 169,
    "text": "رب نجنی وأهلی مما یعملون",
    "page": 374
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 170,
    "text": "فنجینـه وأهله أجمعین",
    "page": 374
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 171,
    "text": "إلا عجوزا فی ٱلغـبرین",
    "page": 374
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 172,
    "text": "ثم دمرنا ٱلـٔاخرین",
    "page": 374
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 173,
    "text": "وأمطرنا علیهم مطرا فساء مطر ٱلمنذرین",
    "page": 374
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 174,
    "text": "إن فی ذ ⁠لك لـٔایة وما كان أكثرهم مؤمنین",
    "page": 374
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 175,
    "text": "وإن ربك لهو ٱلعزیز ٱلرحیم",
    "page": 374
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 176,
    "text": "كذب أصحـب لـٔیكة ٱلمرسلین",
    "page": 374
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 177,
    "text": "إذ قال لهم شعیب ألا تتقون",
    "page": 374
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 178,
    "text": "إنی لكم رسول أمین",
    "page": 374
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 179,
    "text": "فٱتقوا ٱلله وأطیعون",
    "page": 374
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 180,
    "text": "وما أسـٔلكم علیه من أجر إن أجری إلا على رب ٱلعـلمین",
    "page": 374
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 181,
    "text": "۞ أوفوا ٱلكیل ولا تكونوا من ٱلمخسرین",
    "page": 374
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 182,
    "text": "وزنوا بٱلقسطاس ٱلمستقیم",
    "page": 374
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 183,
    "text": "ولا تبخسوا ٱلناس أشیاءهم ولا تعثوا فی ٱلأرض مفسدین",
    "page": 374
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 184,
    "text": "وٱتقوا ٱلذی خلقكم وٱلجبلة ٱلأولین",
    "page": 375
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 185,
    "text": "قالوا إنما أنت من ٱلمسحرین",
    "page": 375
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 186,
    "text": "وما أنت إلا بشر مثلنا وإن نظنك لمن ٱلكـذبین",
    "page": 375
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 187,
    "text": "فأسقط علینا كسفا من ٱلسماء إن كنت من ٱلصـدقین",
    "page": 375
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 188,
    "text": "قال ربی أعلم بما تعملون",
    "page": 375
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 189,
    "text": "فكذبوه فأخذهم عذاب یوم ٱلظلة إنه كان عذاب یوم عظیم",
    "page": 375
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 190,
    "text": "إن فی ذ ⁠لك لـٔایة وما كان أكثرهم مؤمنین",
    "page": 375
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 191,
    "text": "وإن ربك لهو ٱلعزیز ٱلرحیم",
    "page": 375
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 192,
    "text": "وإنه لتنزیل رب ٱلعـلمین",
    "page": 375
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 193,
    "text": "نزل به ٱلروح ٱلأمین",
    "page": 375
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 194,
    "text": "على قلبك لتكون من ٱلمنذرین",
    "page": 375
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 195,
    "text": "بلسان عربیࣲ مبینࣲ",
    "page": 375
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 196,
    "text": "وإنه لفی زبر ٱلأولین",
    "page": 375
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 197,
    "text": "أولم یكن لهم ءایة أن یعلمه علمـؤا بنی إسر ⁠ءیل",
    "page": 375
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 198,
    "text": "ولو نزلنـه على بعض ٱلأعجمین",
    "page": 375
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 199,
    "text": "فقرأه علیهم ما كانوا بهۦ مؤمنین",
    "page": 375
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 200,
    "text": "كذ ⁠لك سلكنـه فی قلوب ٱلمجرمین",
    "page": 375
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 201,
    "text": "لا یؤمنون بهۦ حتى یروا ٱلعذاب ٱلألیم",
    "page": 375
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 202,
    "text": "فیأتیهم بغتة وهم لا یشعرون",
    "page": 375
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 203,
    "text": "فیقولوا هل نحن منظرون",
    "page": 375
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 204,
    "text": "أفبعذابنا یستعجلون",
    "page": 375
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 205,
    "text": "أفرءیت إن متعنـهم سنین",
    "page": 375
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 206,
    "text": "ثم جاءهم ما كانوا یوعدون",
    "page": 375
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 207,
    "text": "ما أغنى عنهم ما كانوا یمتعون",
    "page": 376
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 208,
    "text": "وما أهلكنا من قریة إلا لها منذرون",
    "page": 376
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 209,
    "text": "ذكرى وما كنا ظـلمین",
    "page": 376
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 210,
    "text": "وما تنزلت به ٱلشیـطین",
    "page": 376
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 211,
    "text": "وما ینبغی لهم وما یستطیعون",
    "page": 376
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 212,
    "text": "إنهم عن ٱلسمع لمعزولون",
    "page": 376
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 213,
    "text": "فلا تدع مع ٱلله إلـها ءاخر فتكون من ٱلمعذبین",
    "page": 376
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 214,
    "text": "وأنذر عشیرتك ٱلأقربین",
    "page": 376
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 215,
    "text": "وٱخفض جناحك لمن ٱتبعك من ٱلمؤمنین",
    "page": 376
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 216,
    "text": "فإن عصوك فقل إنی بریء مما تعملون",
    "page": 376
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 217,
    "text": "وتوكل على ٱلعزیز ٱلرحیم",
    "page": 376
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 218,
    "text": "ٱلذی یرىك حین تقوم",
    "page": 376
  },
  {
    "surah": "Ash-Shu'araa",
