[
  {
    "surah": "Ash-Shu'araa",
    "ayah": 1,
    "text": "بسم ٱلله ٱلرحمـن ٱلرحیم طسم",
    "page": 367
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 2,
    "text": "تلك ءایـت ٱلكتـب ٱلمبین",
    "page": 367
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 3,
    "text": "لعلك بـخع نفسك ألا یكونوا مؤمنین",
    "page": 367
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 4,
    "text": "إن نشأ ننزل علیهم من ٱلسماء ءایة فظلت أعنـقهم لها خـضعین",
    "page": 367
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 5,
    "text": "وما یأتیهم من ذكرࣲ من ٱلرحمـن محدث إلا كانوا عنه معرضین",
    "page": 367
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 6,
    "text": "فقد كذبوا فسیأتیهم أنبـؤا ما كانوا بهۦ یستهزءون",
    "page": 367
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 7,
    "text": "أولم یروا إلى ٱلأرض كم أنبتنا فیها من كل زوجࣲ كریم",
    "page": 367
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 8,
    "text": "إن فی ذ ⁠لك لـٔایة وما كان أكثرهم مؤمنین",
    "page": 367
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 9,
    "text": "وإن ربك لهو ٱلعزیز ٱلرحیم",
    "page": 367
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 10,
    "text": "وإذ نادى ربك موسى أن ٱئت ٱلقوم ٱلظـلمین",
    "page": 367
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 11,
    "text": "قوم فرعون ألا یتقون",
    "page": 367
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 12,
    "text": "قال رب إنی أخاف أن یكذبون",
    "page": 367
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 13,
    "text": "ویضیق صدری ولا ینطلق لسانی فأرسل إلى هـرون",
    "page": 367
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 14,
    "text": "ولهم علی ذنب فأخاف أن یقتلون",
    "page": 367
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 15,
    "text": "قال كلا فٱذهبا بـٔایـتنا إنا معكم مستمعون",
    "page": 367
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 16,
    "text": "فأتیا فرعون فقولا إنا رسول رب ٱلعـلمین",
    "page": 367
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 17,
    "text": "أن أرسل معنا بنی إسر ⁠ءیل",
    "page": 367
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 18,
    "text": "قال ألم نربك فینا ولیدا ولبثت فینا من عمرك سنین",
    "page": 367
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 19,
    "text": "وفعلت فعلتك ٱلتی فعلت وأنت من ٱلكـفرین",
    "page": 367
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 20,
    "text": "قال فعلتها إذا وأنا۠ من ٱلضالین",
    "page": 368
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 21,
    "text": "ففررت منكم لما خفتكم فوهب لی ربی حكما وجعلنی من ٱلمرسلین",
    "page": 368
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 22,
    "text": "وتلك نعمة تمنها علی أن عبدت بنی إسر ⁠ءیل",
    "page": 368
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 23,
    "text": "قال فرعون وما رب ٱلعـلمین",
    "page": 368
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 24,
    "text": "قال رب ٱلسمـو ⁠ت وٱلأرض وما بینهما إن كنتم موقنین",
    "page": 368
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 25,
    "text": "قال لمن حوله ألا تستمعون",
    "page": 368
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 26,
    "text": "قال ربكم ورب ءاباىٕكم ٱلأولین",
    "page": 368
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 27,
    "text": "قال إن رسولكم ٱلذی أرسل إلیكم لمجنون",
    "page": 368
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 28,
    "text": "قال رب ٱلمشرق وٱلمغرب وما بینهما إن كنتم تعقلون",
    "page": 368
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 29,
    "text": "قال لىٕن ٱتخذت إلـها غیری لأجعلنك من ٱلمسجونین",
    "page": 368
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 30,
    "text": "قال أولو جئتك بشیءࣲ مبینࣲ",
    "page": 368
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 31,
    "text": "قال فأت بهۦ إن كنت من ٱلصـدقین",
    "page": 368
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 32,
    "text": "فألقى عصاه فإذا هی ثعبان مبین",
    "page": 368
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 33,
    "text": "ونزع یده فإذا هی بیضاء للنـظرین",
    "page": 368
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 34,
    "text": "قال للملإ حوله إن هـذا لسـحر علیم",
    "page": 368
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 35,
    "text": "یرید أن یخرجكم من أرضكم بسحرهۦ فماذا تأمرون",
    "page": 368
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 36,
    "text": "قالوا أرجه وأخاه وٱبعث فی ٱلمداىٕن حـشرین",
    "page": 368
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 37,
    "text": "یأتوك بكل سحار علیمࣲ",
    "page": 368
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 38,
    "text": "فجمع ٱلسحرة لمیقـت یومࣲ معلومࣲ",
    "page": 368
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 39,
    "text": "وقیل للناس هل أنتم مجتمعون",
    "page": 368
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 40,
    "text": "لعلنا نتبع ٱلسحرة إن كانوا هم ٱلغـلبین",
    "page": 369
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 41,
    "text": "فلما جاء ٱلسحرة قالوا لفرعون أىٕن لنا لأجرا إن كنا نحن ٱلغـلبین",
    "page": 369
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 42,
    "text": "قال نعم وإنكم إذا لمن ٱلمقربین",
    "page": 369
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 43,
    "text": "قال لهم موسى ألقوا ما أنتم ملقون",
    "page": 369
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 44,
    "text": "فألقوا حبالهم وعصیهم وقالوا بعزة فرعون إنا لنحن ٱلغـلبون",
    "page": 369
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 45,
    "text": "فألقى موسى عصاه فإذا هی تلقف ما یأفكون",
    "page": 369
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 46,
    "text": "فألقی ٱلسحرة سـجدین",
    "page": 369
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 47,
    "text": "قالوا ءامنا برب ٱلعـلمین",
    "page": 369
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 48,
    "text": "رب موسى وهـرون",
    "page": 369
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 49,
    "text": "قال ءامنتم له قبل أن ءاذن لكم إنه لكبیركم ٱلذی علمكم ٱلسحر فلسوف تعلمون لأقطعن أیدیكم وأرجلكم من خلـفࣲ ولأصلبنكم أجمعین",
    "page": 369
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 50,
    "text": "قالوا لا ضیر إنا إلى ربنا منقلبون",
    "page": 369
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 51,
    "text": "إنا نطمع أن یغفر لنا ربنا خطـیـنا أن كنا أول ٱلمؤمنین",
    "page": 369
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 52,
    "text": "۞ وأوحینا إلى موسى أن أسر بعبادی إنكم متبعون",
    "page": 369
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 53,
    "text": "فأرسل فرعون فی ٱلمداىٕن حـشرین",
    "page": 369
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 54,
    "text": "إن هـؤلاء لشرذمة قلیلون",
    "page": 369
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 55,
    "text": "وإنهم لنا لغاىٕظون",
    "page": 369
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 56,
    "text": "وإنا لجمیع حـذرون",
    "page": 369
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 57,
    "text": "فأخرجنـهم من جنـتࣲ وعیونࣲ",
    "page": 369
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 58,
    "text": "وكنوزࣲ ومقامࣲ كریمࣲ",
    "page": 369
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 59,
    "text": "كذ ⁠لك وأورثنـها بنی إسر ⁠ءیل",
    "page": 369
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 60,
    "text": "فأتبعوهم مشرقین",
    "page": 369
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 61,
    "text": "فلما تر ⁠ءا ٱلجمعان قال أصحـب موسى إنا لمدركون",
    "page": 370
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 62,
    "text": "قال كلا إن معی ربی سیهدین",
    "page": 370
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 63,
    "text": "فأوحینا إلى موسى أن ٱضرب بعصاك ٱلبحر فٱنفلق فكان كل فرقࣲ كٱلطود ٱلعظیم",
    "page": 370
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 64,
    "text": "وأزلفنا ثم ٱلـٔاخرین",
    "page": 370
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 65,
    "text": "وأنجینا موسى ومن معه أجمعین",
    "page": 370
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 66,
    "text": "ثم أغرقنا ٱلـٔاخرین",
    "page": 370
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 67,
    "text": "إن فی ذ ⁠لك لـٔایة وما كان أكثرهم مؤمنین",
    "page": 370
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 68,
    "text": "وإن ربك لهو ٱلعزیز ٱلرحیم",
    "page": 370
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 69,
    "text": "وٱتل علیهم نبأ إبر ⁠هیم",
    "page": 370
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 70,
    "text": "إذ قال لأبیه وقومهۦ ما تعبدون",
    "page": 370
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 71,
    "text": "قالوا نعبد أصناما فنظل لها عـكفین",
    "page": 370
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 72,
    "text": "قال هل یسمعونكم إذ تدعون",
    "page": 370
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 73,
    "text": "أو ینفعونكم أو یضرون",
    "page": 370
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 74,
    "text": "قالوا بل وجدنا ءاباءنا كذ ⁠لك یفعلون",
    "page": 370
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 75,
    "text": "قال أفرءیتم ما كنتم تعبدون",
    "page": 370
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 76,
    "text": "أنتم وءاباؤكم ٱلأقدمون",
    "page": 370
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 77,
    "text": "فإنهم عدو لی إلا رب ٱلعـلمین",
    "page": 370
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 78,
    "text": "ٱلذی خلقنی فهو یهدین",
    "page": 370
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 79,
    "text": "وٱلذی هو یطعمنی ویسقین",
    "page": 370
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 80,
    "text": "وإذا مرضت فهو یشفین",
    "page": 370
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 81,
    "text": "وٱلذی یمیتنی ثم یحیین",
    "page": 370
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 82,
    "text": "وٱلذی أطمع أن یغفر لی خطیـٔتی یوم ٱلدین",
    "page": 370
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 83,
    "text": "رب هب لی حكما وألحقنی بٱلصـلحین",
    "page": 370
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 84,
    "text": "وٱجعل لی لسان صدقࣲ فی ٱلـٔاخرین",
    "page": 371
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 85,
    "text": "وٱجعلنی من ورثة جنة ٱلنعیم",
    "page": 371
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 86,
    "text": "وٱغفر لأبی إنه كان من ٱلضالین",
    "page": 371
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 87,
    "text": "ولا تخزنی یوم یبعثون",
    "page": 371
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 88,
    "text": "یوم لا ینفع مال ولا بنون",
    "page": 371
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 89,
    "text": "إلا من أتى ٱلله بقلبࣲ سلیمࣲ",
    "page": 371
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 90,
    "text": "وأزلفت ٱلجنة للمتقین",
    "page": 371
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 91,
    "text": "وبرزت ٱلجحیم للغاوین",
    "page": 371
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 92,
    "text": "وقیل لهم أین ما كنتم تعبدون",
    "page": 371
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 93,
    "text": "من دون ٱلله هل ینصرونكم أو ینتصرون",
    "page": 371
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 94,
    "text": "فكبكبوا فیها هم وٱلغاون",
    "page": 371
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 95,
    "text": "وجنود إبلیس أجمعون",
    "page": 371
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 96,
    "text": "قالوا وهم فیها یختصمون",
    "page": 371
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 97,
    "text": "تٱلله إن كنا لفی ضلـلࣲ مبین",
    "page": 371
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 98,
    "text": "إذ نسویكم برب ٱلعـلمین",
    "page": 371
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 99,
    "text": "وما أضلنا إلا ٱلمجرمون",
    "page": 371
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 100,
    "text": "فما لنا من شـفعین",
    "page": 371
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 101,
    "text": "ولا صدیق حمیمࣲ",
    "page": 371
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 102,
    "text": "فلو أن لنا كرة فنكون من ٱلمؤمنین",
    "page": 371
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 103,
    "text": "إن فی ذ ⁠لك لـٔایة وما كان أكثرهم مؤمنین",
    "page": 371
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 104,
    "text": "وإن ربك لهو ٱلعزیز ٱلرحیم",
    "page": 371
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 105,
    "text": "كذبت قوم نوح ٱلمرسلین",
    "page": 371
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 106,
    "text": "إذ قال لهم أخوهم نوح ألا تتقون",
    "page": 371
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 107,
    "text": "إنی لكم رسول أمین",
    "page": 371
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 108,
    "text": "فٱتقوا ٱلله وأطیعون",
    "page": 371
  },
  {
    "surah": "Ash-Shu'araa",
    "ayah": 109,
    "text": "وما أسـٔلكم علیه من أجر إن أجری إلا على رب ٱلعـلمین",
