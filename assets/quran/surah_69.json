[
  {
    "surah": "Al-Haaqqa",
    "ayah": 1,
    "text": "بسم ٱلله ٱلرحمـن ٱلرحیم ٱلحاقة",
    "page": 566
  },
  {
    "surah": "Al-Haaqqa",
    "ayah": 2,
    "text": "ما ٱلحاقة",
    "page": 566
  },
  {
    "surah": "Al-Haaqqa",
    "ayah": 3,
    "text": "وما أدرىك ما ٱلحاقة",
    "page": 566
  },
  {
    "surah": "Al-Haaqqa",
    "ayah": 4,
    "text": "كذبت ثمود وعاد بٱلقارعة",
    "page": 566
  },
  {
    "surah": "Al-Haaqqa",
    "ayah": 5,
    "text": "فأما ثمود فأهلكوا بٱلطاغیة",
    "page": 566
  },
  {
    "surah": "Al-Haaqqa",
    "ayah": 6,
    "text": "وأما عاد فأهلكوا بریحࣲ صرصر عاتیةࣲ",
    "page": 566
  },
  {
    "surah": "Al-Haaqqa",
    "ayah": 7,
    "text": "سخرها علیهم سبع لیالࣲ وثمـنیة أیام حسوما فترى ٱلقوم فیها صرعى كأنهم أعجاز نخل خاویةࣲ",
    "page": 566
  },
  {
    "surah": "Al-Haaqqa",
    "ayah": 8,
    "text": "فهل ترى لهم من باقیةࣲ",
    "page": 566
  },
  {
    "surah": "Al-Haaqqa",
    "ayah": 9,
    "text": "وجاء فرعون ومن قبله وٱلمؤتفكـت بٱلخاطئة",
    "page": 567
  },
  {
    "surah": "Al-Haaqqa",
    "ayah": 10,
    "text": "فعصوا رسول ربهم فأخذهم أخذة رابیة",
    "page": 567
  },
  {
    "surah": "Al-Haaqqa",
    "ayah": 11,
    "text": "إنا لما طغا ٱلماء حملنـكم فی ٱلجاریة",
    "page": 567
  },
  {
    "surah": "Al-Haaqqa",
    "ayah": 12,
    "text": "لنجعلها لكم تذكرة وتعیها أذن و ⁠عیة",
    "page": 567
  },
  {
    "surah": "Al-Haaqqa",
    "ayah": 13,
    "text": "فإذا نفخ فی ٱلصور نفخة و ⁠حدة",
    "page": 567
  },
  {
    "surah": "Al-Haaqqa",
    "ayah": 14,
    "text": "وحملت ٱلأرض وٱلجبال فدكتا دكة و ⁠حدة",
    "page": 567
  },
  {
    "surah": "Al-Haaqqa",
    "ayah": 15,
    "text": "فیومىٕذࣲ وقعت ٱلواقعة",
    "page": 567
  },
  {
    "surah": "Al-Haaqqa",
    "ayah": 16,
    "text": "وٱنشقت ٱلسماء فهی یومىٕذࣲ واهیة",
    "page": 567
  },
  {
    "surah": "Al-Haaqqa",
    "ayah": 17,
    "text": "وٱلملك على أرجاىٕها ویحمل عرش ربك فوقهم یومىٕذࣲ ثمـنیة",
    "page": 567
  },
  {
    "surah": "Al-Haaqqa",
    "ayah": 18,
    "text": "یومىٕذࣲ تعرضون لا تخفى منكم خافیة",
    "page": 567
  },
  {
    "surah": "Al-Haaqqa",
    "ayah": 19,
    "text": "فأما من أوتی كتـبه بیمینهۦ فیقول هاؤم ٱقرءوا كتـبیه",
    "page": 567
  },
  {
    "surah": "Al-Haaqqa",
    "ayah": 20,
    "text": "إنی ظننت أنی ملـق حسابیه",
    "page": 567
  },
  {
    "surah": "Al-Haaqqa",
    "ayah": 21,
    "text": "فهو فی عیشةࣲ راضیةࣲ",
    "page": 567
  },
  {
    "surah": "Al-Haaqqa",
    "ayah": 22,
    "text": "فی جنة عالیةࣲ",
    "page": 567
  },
  {
    "surah": "Al-Haaqqa",
    "ayah": 23,
    "text": "قطوفها دانیة",
    "page": 567
  },
  {
    "surah": "Al-Haaqqa",
    "ayah": 24,
    "text": "كلوا وٱشربوا هنیـٔا بما أسلفتم فی ٱلأیام ٱلخالیة",
    "page": 567
  },
  {
    "surah": "Al-Haaqqa",
    "ayah": 25,
    "text": "وأما من أوتی كتـبه بشمالهۦ فیقول یـلیتنی لم أوت كتـبیه",
    "page": 567
  },
  {
    "surah": "Al-Haaqqa",
    "ayah": 26,
    "text": "ولم أدر ما حسابیه",
    "page": 567
  },
  {
    "surah": "Al-Haaqqa",
    "ayah": 27,
    "text": "یـلیتها كانت ٱلقاضیة",
    "page": 567
  },
  {
    "surah": "Al-Haaqqa",
    "ayah": 28,
    "text": "ما أغنى عنی مالیه",
    "page": 567
  },
  {
    "surah": "Al-Haaqqa",
    "ayah": 29,
    "text": "هلك عنی سلطـنیه",
    "page": 567
  },
  {
    "surah": "Al-Haaqqa",
    "ayah": 30,
    "text": "خذوه فغلوه",
    "page": 567
  },
  {
    "surah": "Al-Haaqqa",
    "ayah": 31,
    "text": "ثم ٱلجحیم صلوه",
    "page": 567
  },
  {
    "surah": "Al-Haaqqa",
    "ayah": 32,
    "text": "ثم فی سلسلةࣲ ذرعها سبعون ذراعا فٱسلكوه",
    "page": 567
  },
  {
    "surah": "Al-Haaqqa",
    "ayah": 33,
    "text": "إنه كان لا یؤمن بٱلله ٱلعظیم",
    "page": 567
  },
  {
    "surah": "Al-Haaqqa",
    "ayah": 34,
    "text": "ولا یحض على طعام ٱلمسكین",
    "page": 567
  },
  {
    "surah": "Al-Haaqqa",
    "ayah": 35,
    "text": "فلیس له ٱلیوم هـهنا حمیم",
    "page": 568
  },
  {
    "surah": "Al-Haaqqa",
    "ayah": 36,
    "text": "ولا طعام إلا من غسلینࣲ",
    "page": 568
  },
  {
    "surah": "Al-Haaqqa",
    "ayah": 37,
    "text": "لا یأكله إلا ٱلخـطـٔون",
    "page": 568
  },
  {
    "surah": "Al-Haaqqa",
    "ayah": 38,
    "text": "فلا أقسم بما تبصرون",
    "page": 568
  },
  {
    "surah": "Al-Haaqqa",
    "ayah": 39,
    "text": "وما لا تبصرون",
    "page": 568
  },
  {
    "surah": "Al-Haaqqa",
    "ayah": 40,
    "text": "إنه لقول رسولࣲ كریمࣲ",
    "page": 568
  },
  {
    "surah": "Al-Haaqqa",
    "ayah": 41,
    "text": "وما هو بقول شاعرࣲ قلیلا ما تؤمنون",
    "page": 568
  },
  {
    "surah": "Al-Haaqqa",
    "ayah": 42,
    "text": "ولا بقول كاهنࣲ قلیلا ما تذكرون",
    "page": 568
  },
  {
    "surah": "Al-Haaqqa",
    "ayah": 43,
    "text": "تنزیل من رب ٱلعـلمین",
    "page": 568
  },
  {
    "surah": "Al-Haaqqa",
    "ayah": 44,
    "text": "ولو تقول علینا بعض ٱلأقاویل",
    "page": 568
  },
  {
    "surah": "Al-Haaqqa",
    "ayah": 45,
    "text": "لأخذنا منه بٱلیمین",
    "page": 568
  },
  {
    "surah": "Al-Haaqqa",
    "ayah": 46,
    "text": "ثم لقطعنا منه ٱلوتین",
    "page": 568
  },
  {
    "surah": "Al-Haaqqa",
    "ayah": 47,
    "text": "فما منكم من أحد عنه حـجزین",
    "page": 568
  },
  {
    "surah": "Al-Haaqqa",
    "ayah": 48,
    "text": "وإنه لتذكرة للمتقین",
    "page": 568
  },
  {
    "surah": "Al-Haaqqa",
    "ayah": 49,
    "text": "وإنا لنعلم أن منكم مكذبین",
    "page": 568
  },
  {
    "surah": "Al-Haaqqa",
    "ayah": 50,
    "text": "وإنه لحسرة على ٱلكـفرین",
    "page": 568
  },
  {
    "surah": "Al-Haaqqa",
    "ayah": 51,
    "text": "وإنه لحق ٱلیقین",
    "page": 568
  },
  {
    "surah": "Al-Haaqqa",
    "ayah": 52,
    "text": "فسبح بٱسم ربك ٱلعظیم",
    "page": 568
  }
]