[
  {
    "surah": "Al-Waaqia",
    "ayah": 1,
    "text": "بسم ٱلله ٱلرحمـن ٱلرحیم إذا وقعت ٱلواقعة",
    "page": 534
  },
  {
    "surah": "Al-Waaqia",
    "ayah": 2,
    "text": "لیس لوقعتها كاذبة",
    "page": 534
  },
  {
    "surah": "Al-Waaqia",
    "ayah": 3,
    "text": "خافضة رافعة",
    "page": 534
  },
  {
    "surah": "Al-Waaqia",
    "ayah": 4,
    "text": "إذا رجت ٱلأرض رجا",
    "page": 534
  },
  {
    "surah": "Al-Waaqia",
    "ayah": 5,
    "text": "وبست ٱلجبال بسا",
    "page": 534
  },
  {
    "surah": "Al-Waaqia",
    "ayah": 6,
    "text": "فكانت هباء منبثا",
    "page": 534
  },
  {
    "surah": "Al-Waaqia",
    "ayah": 7,
    "text": "وكنتم أزو ⁠جا ثلـثة",
    "page": 534
  },
  {
    "surah": "Al-Waaqia",
    "ayah": 8,
    "text": "فأصحـب ٱلمیمنة ما أصحـب ٱلمیمنة",
    "page": 534
  },
  {
    "surah": "Al-Waaqia",
    "ayah": 9,
    "text": "وأصحـب ٱلمشـٔمة ما أصحـب ٱلمشـٔمة",
    "page": 534
  },
  {
    "surah": "Al-Waaqia",
    "ayah": 10,
    "text": "وٱلسـبقون ٱلسـبقون",
    "page": 534
  },
  {
    "surah": "Al-Waaqia",
    "ayah": 11,
    "text": "أولـىٕك ٱلمقربون",
    "page": 534
  },
  {
    "surah": "Al-Waaqia",
    "ayah": 12,
    "text": "فی جنـت ٱلنعیم",
    "page": 534
  },
  {
    "surah": "Al-Waaqia",
    "ayah": 13,
    "text": "ثلة من ٱلأولین",
    "page": 534
  },
  {
    "surah": "Al-Waaqia",
    "ayah": 14,
    "text": "وقلیل من ٱلـٔاخرین",
    "page": 534
  },
  {
    "surah": "Al-Waaqia",
    "ayah": 15,
    "text": "على سررࣲ موضونةࣲ",
    "page": 534
  },
  {
    "surah": "Al-Waaqia",
    "ayah": 16,
    "text": "متكـٔین علیها متقـبلین",
    "page": 534
  },
  {
    "surah": "Al-Waaqia",
    "ayah": 17,
    "text": "یطوف علیهم ولد ⁠ن مخلدون",
    "page": 535
  },
  {
    "surah": "Al-Waaqia",
    "ayah": 18,
    "text": "بأكوابࣲ وأباریق وكأسࣲ من معینࣲ",
    "page": 535
  },
  {
    "surah": "Al-Waaqia",
    "ayah": 19,
    "text": "لا یصدعون عنها ولا ینزفون",
    "page": 535
  },
  {
    "surah": "Al-Waaqia",
    "ayah": 20,
    "text": "وفـكهةࣲ مما یتخیرون",
    "page": 535
  },
  {
    "surah": "Al-Waaqia",
    "ayah": 21,
    "text": "ولحم طیرࣲ مما یشتهون",
    "page": 535
  },
  {
    "surah": "Al-Waaqia",
    "ayah": 22,
    "text": "وحور عین",
    "page": 535
  },
  {
    "surah": "Al-Waaqia",
    "ayah": 23,
    "text": "كأمثـل ٱللؤلوٕ ٱلمكنون",
    "page": 535
  },
  {
    "surah": "Al-Waaqia",
    "ayah": 24,
    "text": "جزاء بما كانوا یعملون",
    "page": 535
  },
  {
    "surah": "Al-Waaqia",
    "ayah": 25,
    "text": "لا یسمعون فیها لغوا ولا تأثیما",
    "page": 535
  },
  {
    "surah": "Al-Waaqia",
    "ayah": 26,
    "text": "إلا قیلا سلـما سلـما",
    "page": 535
  },
  {
    "surah": "Al-Waaqia",
    "ayah": 27,
    "text": "وأصحـب ٱلیمین ما أصحـب ٱلیمین",
    "page": 535
  },
  {
    "surah": "Al-Waaqia",
    "ayah": 28,
    "text": "فی سدرࣲ مخضودࣲ",
    "page": 535
  },
  {
    "surah": "Al-Waaqia",
    "ayah": 29,
    "text": "وطلحࣲ منضودࣲ",
    "page": 535
  },
  {
    "surah": "Al-Waaqia",
    "ayah": 30,
    "text": "وظلࣲ ممدودࣲ",
    "page": 535
  },
  {
    "surah": "Al-Waaqia",
    "ayah": 31,
    "text": "وماءࣲ مسكوبࣲ",
    "page": 535
  },
  {
    "surah": "Al-Waaqia",
    "ayah": 32,
    "text": "وفـكهةࣲ كثیرةࣲ",
    "page": 535
  },
  {
    "surah": "Al-Waaqia",
    "ayah": 33,
    "text": "لا مقطوعةࣲ ولا ممنوعةࣲ",
    "page": 535
  },
  {
    "surah": "Al-Waaqia",
    "ayah": 34,
    "text": "وفرشࣲ مرفوعة",
    "page": 535
  },
  {
    "surah": "Al-Waaqia",
    "ayah": 35,
    "text": "إنا أنشأنـهن إنشاء",
    "page": 535
  },
  {
    "surah": "Al-Waaqia",
    "ayah": 36,
    "text": "فجعلنـهن أبكارا",
    "page": 535
  },
  {
    "surah": "Al-Waaqia",
    "ayah": 37,
    "text": "عربا أترابا",
    "page": 535
  },
  {
    "surah": "Al-Waaqia",
    "ayah": 38,
    "text": "لأصحـب ٱلیمین",
    "page": 535
  },
  {
    "surah": "Al-Waaqia",
    "ayah": 39,
    "text": "ثلة من ٱلأولین",
    "page": 535
  },
  {
    "surah": "Al-Waaqia",
    "ayah": 40,
    "text": "وثلة من ٱلـٔاخرین",
    "page": 535
  },
  {
    "surah": "Al-Waaqia",
    "ayah": 41,
    "text": "وأصحـب ٱلشمال ما أصحـب ٱلشمال",
    "page": 535
  },
  {
    "surah": "Al-Waaqia",
    "ayah": 42,
    "text": "فی سمومࣲ وحمیمࣲ",
    "page": 535
  },
  {
    "surah": "Al-Waaqia",
    "ayah": 43,
    "text": "وظلࣲ من یحمومࣲ",
    "page": 535
  },
  {
    "surah": "Al-Waaqia",
    "ayah": 44,
    "text": "لا باردࣲ ولا كریم",
    "page": 535
  },
  {
    "surah": "Al-Waaqia",
    "ayah": 45,
    "text": "إنهم كانوا قبل ذ ⁠لك مترفین",
    "page": 535
  },
  {
    "surah": "Al-Waaqia",
    "ayah": 46,
    "text": "وكانوا یصرون على ٱلحنث ٱلعظیم",
    "page": 535
  },
  {
    "surah": "Al-Waaqia",
    "ayah": 47,
    "text": "وكانوا یقولون أىٕذا متنا وكنا ترابا وعظـما أءنا لمبعوثون",
    "page": 535
  },
  {
    "surah": "Al-Waaqia",
    "ayah": 48,
    "text": "أوءاباؤنا ٱلأولون",
    "page": 535
  },
  {
    "surah": "Al-Waaqia",
    "ayah": 49,
    "text": "قل إن ٱلأولین وٱلـٔاخرین",
    "page": 535
  },
  {
    "surah": "Al-Waaqia",
    "ayah": 50,
    "text": "لمجموعون إلى میقـت یومࣲ معلومࣲ",
    "page": 535
  },
  {
    "surah": "Al-Waaqia",
    "ayah": 51,
    "text": "ثم إنكم أیها ٱلضالون ٱلمكذبون",
    "page": 536
  },
  {
    "surah": "Al-Waaqia",
    "ayah": 52,
    "text": "لـٔاكلون من شجرࣲ من زقومࣲ",
    "page": 536
  },
  {
    "surah": "Al-Waaqia",
    "ayah": 53,
    "text": "فمالـٔون منها ٱلبطون",
    "page": 536
  },
  {
    "surah": "Al-Waaqia",
    "ayah": 54,
    "text": "فشـربون علیه من ٱلحمیم",
    "page": 536
  },
  {
    "surah": "Al-Waaqia",
    "ayah": 55,
    "text": "فشـربون شرب ٱلهیم",
    "page": 536
  },
  {
    "surah": "Al-Waaqia",
    "ayah": 56,
    "text": "هـذا نزلهم یوم ٱلدین",
    "page": 536
  },
  {
    "surah": "Al-Waaqia",
    "ayah": 57,
    "text": "نحن خلقنـكم فلولا تصدقون",
    "page": 536
  },
  {
    "surah": "Al-Waaqia",
    "ayah": 58,
    "text": "أفرءیتم ما تمنون",
    "page": 536
  },
  {
    "surah": "Al-Waaqia",
    "ayah": 59,
    "text": "ءأنتم تخلقونه أم نحن ٱلخـلقون",
    "page": 536
  },
  {
    "surah": "Al-Waaqia",
    "ayah": 60,
    "text": "نحن قدرنا بینكم ٱلموت وما نحن بمسبوقین",
    "page": 536
  },
  {
    "surah": "Al-Waaqia",
    "ayah": 61,
    "text": "على أن نبدل أمثـلكم وننشئكم فی ما لا تعلمون",
    "page": 536
  },
  {
    "surah": "Al-Waaqia",
    "ayah": 62,
    "text": "ولقد علمتم ٱلنشأة ٱلأولى فلولا تذكرون",
    "page": 536
  },
  {
    "surah": "Al-Waaqia",
    "ayah": 63,
    "text": "أفرءیتم ما تحرثون",
    "page": 536
  },
  {
    "surah": "Al-Waaqia",
    "ayah": 64,
    "text": "ءأنتم تزرعونه أم نحن ٱلز ⁠رعون",
    "page": 536
  },
  {
    "surah": "Al-Waaqia",
    "ayah": 65,
    "text": "لو نشاء لجعلنـه حطـما فظلتم تفكهون",
    "page": 536
  },
  {
    "surah": "Al-Waaqia",
    "ayah": 66,
    "text": "إنا لمغرمون",
    "page": 536
  },
  {
    "surah": "Al-Waaqia",
    "ayah": 67,
    "text": "بل نحن محرومون",
    "page": 536
  },
  {
    "surah": "Al-Waaqia",
    "ayah": 68,
    "text": "أفرءیتم ٱلماء ٱلذی تشربون",
    "page": 536
  },
  {
    "surah": "Al-Waaqia",
    "ayah": 69,
    "text": "ءأنتم أنزلتموه من ٱلمزن أم نحن ٱلمنزلون",
    "page": 536
  },
  {
    "surah": "Al-Waaqia",
    "ayah": 70,
    "text": "لو نشاء جعلنـه أجاجا فلولا تشكرون",
    "page": 536
  },
  {
    "surah": "Al-Waaqia",
    "ayah": 71,
    "text": "أفرءیتم ٱلنار ٱلتی تورون",
    "page": 536
  },
  {
    "surah": "Al-Waaqia",
    "ayah": 72,
    "text": "ءأنتم أنشأتم شجرتها أم نحن ٱلمنشـٔون",
    "page": 536
  },
  {
    "surah": "Al-Waaqia",
    "ayah": 73,
    "text": "نحن جعلنـها تذكرة ومتـعا للمقوین",
    "page": 536
  },
  {
    "surah": "Al-Waaqia",
    "ayah": 74,
    "text": "فسبح بٱسم ربك ٱلعظیم",
    "page": 536
  },
  {
    "surah": "Al-Waaqia",
    "ayah": 75,
    "text": "۞ فلا أقسم بمو ⁠قع ٱلنجوم",
    "page": 536
  },
  {
    "surah": "Al-Waaqia",
    "ayah": 76,
    "text": "وإنه لقسم لو تعلمون عظیم",
    "page": 536
  },
  {
    "surah": "Al-Waaqia",
    "ayah": 77,
    "text": "إنه لقرءان كریم",
    "page": 537
  },
  {
    "surah": "Al-Waaqia",
    "ayah": 78,
    "text": "فی كتـبࣲ مكنونࣲ",
    "page": 537
  },
  {
    "surah": "Al-Waaqia",
    "ayah": 79,
    "text": "لا یمسه إلا ٱلمطهرون",
    "page": 537
  },
  {
    "surah": "Al-Waaqia",
    "ayah": 80,
    "text": "تنزیل من رب ٱلعـلمین",
    "page": 537
  },
  {
    "surah": "Al-Waaqia",
    "ayah": 81,
    "text": "أفبهـذا ٱلحدیث أنتم مدهنون",
    "page": 537
  },
  {
    "surah": "Al-Waaqia",
    "ayah": 82,
    "text": "وتجعلون رزقكم أنكم تكذبون",
    "page": 537
  },
  {
    "surah": "Al-Waaqia",
    "ayah": 83,
    "text": "فلولا إذا بلغت ٱلحلقوم",
    "page": 537
  },
  {
    "surah": "Al-Waaqia",
    "ayah": 84,
    "text": "وأنتم حینىٕذࣲ تنظرون",
    "page": 537
  },
  {
    "surah": "Al-Waaqia",
    "ayah": 85,
    "text": "ونحن أقرب إلیه منكم ولـكن لا تبصرون",
    "page": 537
  },
  {
    "surah": "Al-Waaqia",
    "ayah": 86,
    "text": "فلولا إن كنتم غیر مدینین",
    "page": 537
  },
  {
    "surah": "Al-Waaqia",
    "ayah": 87,
    "text": "ترجعونها إن كنتم صـدقین",
    "page": 537
  },
  {
    "surah": "Al-Waaqia",
    "ayah": 88,
    "text": "فأما إن كان من ٱلمقربین",
    "page": 537
  },
  {
    "surah": "Al-Waaqia",
    "ayah": 89,
    "text": "فروح وریحان وجنت نعیمࣲ",
    "page": 537
  },
  {
    "surah": "Al-Waaqia",
    "ayah": 90,
    "text": "وأما إن كان من أصحـب ٱلیمین",
    "page": 537
  },
  {
    "surah": "Al-Waaqia",
    "ayah": 91,
    "text": "فسلـم لك من أصحـب ٱلیمین",
    "page": 537
  },
  {
    "surah": "Al-Waaqia",
    "ayah": 92,
    "text": "وأما إن كان من ٱلمكذبین ٱلضالین",
    "page": 537
  },
  {
    "surah": "Al-Waaqia",
    "ayah": 93,
    "text": "فنزل من حمیمࣲ",
    "page": 537
  },
  {
    "surah": "Al-Waaqia",
    "ayah": 94,
    "text": "وتصلیة جحیم",
    "page": 537
  },
  {
    "surah": "Al-Waaqia",
    "ayah": 95,
    "text": "إن هـذا لهو حق ٱلیقین",
    "page": 537
  },
  {
    "surah": "Al-Waaqia",
    "ayah": 96,
    "text": "فسبح بٱسم ربك ٱلعظیم",
    "page": 537
  }
]