[
  {
    "surah": "Adh-Dhaariyat",
    "ayah": 1,
    "text": "بسم ٱلله ٱلرحمـن ٱلرحیم وٱلذ ⁠ریـت ذروا",
    "page": 520
  },
  {
    "surah": "Adh-Dhaariyat",
    "ayah": 2,
    "text": "فٱلحـملـت وقرا",
    "page": 520
  },
  {
    "surah": "Adh-Dhaariyat",
    "ayah": 3,
    "text": "فٱلجـریـت یسرا",
    "page": 520
  },
  {
    "surah": "Adh-Dhaariyat",
    "ayah": 4,
    "text": "فٱلمقسمـت أمرا",
    "page": 520
  },
  {
    "surah": "Adh-Dhaariyat",
    "ayah": 5,
    "text": "إنما توعدون لصادق",
    "page": 520
  },
  {
    "surah": "Adh-Dhaariyat",
    "ayah": 6,
    "text": "وإن ٱلدین لو ⁠قع",
    "page": 520
  },
  {
    "surah": "Adh-Dhaariyat",
    "ayah": 7,
    "text": "وٱلسماء ذات ٱلحبك",
    "page": 521
  },
  {
    "surah": "Adh-Dhaariyat",
    "ayah": 8,
    "text": "إنكم لفی قولࣲ مختلفࣲ",
    "page": 521
  },
  {
    "surah": "Adh-Dhaariyat",
    "ayah": 9,
    "text": "یؤفك عنه من أفك",
    "page": 521
  },
  {
    "surah": "Adh-Dhaariyat",
    "ayah": 10,
    "text": "قتل ٱلخر ⁠صون",
    "page": 521
  },
  {
    "surah": "Adh-Dhaariyat",
    "ayah": 11,
    "text": "ٱلذین هم فی غمرةࣲ ساهون",
    "page": 521
  },
  {
    "surah": "Adh-Dhaariyat",
    "ayah": 12,
    "text": "یسـٔلون أیان یوم ٱلدین",
    "page": 521
  },
  {
    "surah": "Adh-Dhaariyat",
    "ayah": 13,
    "text": "یوم هم على ٱلنار یفتنون",
    "page": 521
  },
  {
    "surah": "Adh-Dhaariyat",
    "ayah": 14,
    "text": "ذوقوا فتنتكم هـذا ٱلذی كنتم بهۦ تستعجلون",
    "page": 521
  },
  {
    "surah": "Adh-Dhaariyat",
    "ayah": 15,
    "text": "إن ٱلمتقین فی جنـتࣲ وعیون",
    "page": 521
  },
  {
    "surah": "Adh-Dhaariyat",
    "ayah": 16,
    "text": "ءاخذین ما ءاتىهم ربهم إنهم كانوا قبل ذ ⁠لك محسنین",
    "page": 521
  },
  {
    "surah": "Adh-Dhaariyat",
    "ayah": 17,
    "text": "كانوا قلیلا من ٱلیل ما یهجعون",
    "page": 521
  },
  {
    "surah": "Adh-Dhaariyat",
    "ayah": 18,
    "text": "وبٱلأسحار هم یستغفرون",
    "page": 521
  },
  {
    "surah": "Adh-Dhaariyat",
    "ayah": 19,
    "text": "وفی أمو ⁠لهم حق للساىٕل وٱلمحروم",
    "page": 521
  },
  {
    "surah": "Adh-Dhaariyat",
    "ayah": 20,
    "text": "وفی ٱلأرض ءایـت للموقنین",
    "page": 521
  },
  {
    "surah": "Adh-Dhaariyat",
    "ayah": 21,
    "text": "وفی أنفسكم أفلا تبصرون",
    "page": 521
  },
  {
    "surah": "Adh-Dhaariyat",
    "ayah": 22,
    "text": "وفی ٱلسماء رزقكم وما توعدون",
    "page": 521
  },
  {
    "surah": "Adh-Dhaariyat",
    "ayah": 23,
    "text": "فورب ٱلسماء وٱلأرض إنه لحق مثل ما أنكم تنطقون",
    "page": 521
  },
  {
    "surah": "Adh-Dhaariyat",
    "ayah": 24,
    "text": "هل أتىك حدیث ضیف إبر ⁠هیم ٱلمكرمین",
    "page": 521
  },
  {
    "surah": "Adh-Dhaariyat",
    "ayah": 25,
    "text": "إذ دخلوا علیه فقالوا سلـما قال سلـم قوم منكرون",
    "page": 521
  },
  {
    "surah": "Adh-Dhaariyat",
    "ayah": 26,
    "text": "فراغ إلى أهلهۦ فجاء بعجلࣲ سمینࣲ",
    "page": 521
  },
  {
    "surah": "Adh-Dhaariyat",
    "ayah": 27,
    "text": "فقربه إلیهم قال ألا تأكلون",
    "page": 521
  },
  {
    "surah": "Adh-Dhaariyat",
    "ayah": 28,
    "text": "فأوجس منهم خیفة قالوا لا تخف وبشروه بغلـم علیمࣲ",
    "page": 521
  },
  {
    "surah": "Adh-Dhaariyat",
    "ayah": 29,
    "text": "فأقبلت ٱمرأته فی صرةࣲ فصكت وجهها وقالت عجوز عقیم",
    "page": 521
  },
  {
    "surah": "Adh-Dhaariyat",
    "ayah": 30,
    "text": "قالوا كذ ⁠لك قال ربك إنه هو ٱلحكیم ٱلعلیم",
    "page": 521
  },
  {
    "surah": "Adh-Dhaariyat",
    "ayah": 31,
    "text": "۞ قال فما خطبكم أیها ٱلمرسلون",
    "page": 522
  },
  {
    "surah": "Adh-Dhaariyat",
    "ayah": 32,
    "text": "قالوا إنا أرسلنا إلى قومࣲ مجرمین",
    "page": 522
  },
  {
    "surah": "Adh-Dhaariyat",
    "ayah": 33,
    "text": "لنرسل علیهم حجارة من طینࣲ",
    "page": 522
  },
  {
    "surah": "Adh-Dhaariyat",
    "ayah": 34,
    "text": "مسومة عند ربك للمسرفین",
    "page": 522
  },
  {
    "surah": "Adh-Dhaariyat",
    "ayah": 35,
    "text": "فأخرجنا من كان فیها من ٱلمؤمنین",
    "page": 522
  },
  {
    "surah": "Adh-Dhaariyat",
    "ayah": 36,
    "text": "فما وجدنا فیها غیر بیتࣲ من ٱلمسلمین",
    "page": 522
  },
  {
    "surah": "Adh-Dhaariyat",
    "ayah": 37,
    "text": "وتركنا فیها ءایة للذین یخافون ٱلعذاب ٱلألیم",
    "page": 522
  },
  {
    "surah": "Adh-Dhaariyat",
    "ayah": 38,
    "text": "وفی موسى إذ أرسلنـه إلى فرعون بسلطـنࣲ مبینࣲ",
    "page": 522
  },
  {
    "surah": "Adh-Dhaariyat",
    "ayah": 39,
    "text": "فتولى بركنهۦ وقال سـحر أو مجنون",
    "page": 522
  },
  {
    "surah": "Adh-Dhaariyat",
    "ayah": 40,
    "text": "فأخذنـه وجنوده فنبذنـهم فی ٱلیم وهو ملیم",
    "page": 522
  },
  {
    "surah": "Adh-Dhaariyat",
    "ayah": 41,
    "text": "وفی عاد إذ أرسلنا علیهم ٱلریح ٱلعقیم",
    "page": 522
  },
  {
    "surah": "Adh-Dhaariyat",
    "ayah": 42,
    "text": "ما تذر من شیء أتت علیه إلا جعلته كٱلرمیم",
    "page": 522
  },
  {
    "surah": "Adh-Dhaariyat",
    "ayah": 43,
    "text": "وفی ثمود إذ قیل لهم تمتعوا حتى حینࣲ",
    "page": 522
  },
  {
    "surah": "Adh-Dhaariyat",
    "ayah": 44,
    "text": "فعتوا عن أمر ربهم فأخذتهم ٱلصـعقة وهم ینظرون",
    "page": 522
  },
  {
    "surah": "Adh-Dhaariyat",
    "ayah": 45,
    "text": "فما ٱستطـعوا من قیامࣲ وما كانوا منتصرین",
    "page": 522
  },
  {
    "surah": "Adh-Dhaariyat",
    "ayah": 46,
    "text": "وقوم نوحࣲ من قبل إنهم كانوا قوما فـسقین",
    "page": 522
  },
  {
    "surah": "Adh-Dhaariyat",
    "ayah": 47,
    "text": "وٱلسماء بنینـها بأییدࣲ وإنا لموسعون",
    "page": 522
  },
  {
    "surah": "Adh-Dhaariyat",
    "ayah": 48,
    "text": "وٱلأرض فرشنـها فنعم ٱلمـهدون",
    "page": 522
  },
  {
    "surah": "Adh-Dhaariyat",
    "ayah": 49,
    "text": "ومن كل شیء خلقنا زوجین لعلكم تذكرون",
    "page": 522
  },
  {
    "surah": "Adh-Dhaariyat",
    "ayah": 50,
    "text": "ففروا إلى ٱلله إنی لكم منه نذیر مبین",
    "page": 522
  },
  {
    "surah": "Adh-Dhaariyat",
    "ayah": 51,
    "text": "ولا تجعلوا مع ٱلله إلـها ءاخر إنی لكم منه نذیر مبین",
    "page": 522
  },
  {
    "surah": "Adh-Dhaariyat",
    "ayah": 52,
    "text": "كذ ⁠لك ما أتى ٱلذین من قبلهم من رسول إلا قالوا ساحر أو مجنون",
    "page": 523
  },
  {
    "surah": "Adh-Dhaariyat",
    "ayah": 53,
    "text": "أتواصوا بهۦ بل هم قوم طاغون",
    "page": 523
  },
  {
    "surah": "Adh-Dhaariyat",
    "ayah": 54,
    "text": "فتول عنهم فما أنت بملومࣲ",
    "page": 523
  },
  {
    "surah": "Adh-Dhaariyat",
    "ayah": 55,
    "text": "وذكر فإن ٱلذكرى تنفع ٱلمؤمنین",
    "page": 523
  },
  {
    "surah": "Adh-Dhaariyat",
    "ayah": 56,
    "text": "وما خلقت ٱلجن وٱلإنس إلا لیعبدون",
    "page": 523
  },
  {
    "surah": "Adh-Dhaariyat",
    "ayah": 57,
    "text": "ما أرید منهم من رزقࣲ وما أرید أن یطعمون",
    "page": 523
  },
  {
    "surah": "Adh-Dhaariyat",
    "ayah": 58,
    "text": "إن ٱلله هو ٱلرزاق ذو ٱلقوة ٱلمتین",
    "page": 523
  },
  {
    "surah": "Adh-Dhaariyat",
    "ayah": 59,
    "text": "فإن للذین ظلموا ذنوبا مثل ذنوب أصحـبهم فلا یستعجلون",
    "page": 523
  },
  {
    "surah": "Adh-Dhaariyat",
    "ayah": 60,
    "text": "فویل للذین كفروا من یومهم ٱلذی یوعدون",
    "page": 523
  }
]