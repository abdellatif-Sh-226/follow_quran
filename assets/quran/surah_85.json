[
  {
    "surah": "Al-Burooj",
    "ayah": 1,
    "text": "بسم ٱلله ٱلرحمـن ٱلرحیم وٱلسماء ذات ٱلبروج",
    "page": 590
  },
  {
    "surah": "Al-Burooj",
    "ayah": 2,
    "text": "وٱلیوم ٱلموعود",
    "page": 590
  },
  {
    "surah": "Al-Burooj",
    "ayah": 3,
    "text": "وشاهدࣲ ومشهودࣲ",
    "page": 590
  },
  {
    "surah": "Al-Burooj",
    "ayah": 4,
    "text": "قتل أصحـب ٱلأخدود",
    "page": 590
  },
  {
    "surah": "Al-Burooj",
    "ayah": 5,
    "text": "ٱلنار ذات ٱلوقود",
    "page": 590
  },
  {
    "surah": "Al-Burooj",
    "ayah": 6,
    "text": "إذ هم علیها قعود",
    "page": 590
  },
  {
    "surah": "Al-Burooj",
    "ayah": 7,
    "text": "وهم على ما یفعلون بٱلمؤمنین شهود",
    "page": 590
  },
  {
    "surah": "Al-Burooj",
    "ayah": 8,
    "text": "وما نقموا منهم إلا أن یؤمنوا بٱلله ٱلعزیز ٱلحمید",
    "page": 590
  },
  {
    "surah": "Al-Burooj",
    "ayah": 9,
    "text": "ٱلذی له ملك ٱلسمـو ⁠ت وٱلأرض وٱلله على كل شیءࣲ شهید",
    "page": 590
  },
  {
    "surah": "Al-Burooj",
    "ayah": 10,
    "text": "إن ٱلذین فتنوا ٱلمؤمنین وٱلمؤمنـت ثم لم یتوبوا فلهم عذاب جهنم ولهم عذاب ٱلحریق",
    "page": 590
  },
  {
    "surah": "Al-Burooj",
    "ayah": 11,
    "text": "إن ٱلذین ءامنوا وعملوا ٱلصـلحـت لهم جنـت تجری من تحتها ٱلأنهـر ذ ⁠لك ٱلفوز ٱلكبیر",
    "page": 590
  },
  {
    "surah": "Al-Burooj",
    "ayah": 12,
    "text": "إن بطش ربك لشدید",
    "page": 590
  },
  {
    "surah": "Al-Burooj",
    "ayah": 13,
    "text": "إنه هو یبدئ ویعید",
    "page": 590
  },
  {
    "surah": "Al-Burooj",
    "ayah": 14,
    "text": "وهو ٱلغفور ٱلودود",
    "page": 590
  },
  {
    "surah": "Al-Burooj",
    "ayah": 15,
    "text": "ذو ٱلعرش ٱلمجید",
    "page": 590
  },
  {
    "surah": "Al-Burooj",
    "ayah": 16,
    "text": "فعال لما یرید",
    "page": 590
  },
  {
    "surah": "Al-Burooj",
    "ayah": 17,
    "text": "هل أتىك حدیث ٱلجنود",
    "page": 590
  },
  {
    "surah": "Al-Burooj",
    "ayah": 18,
    "text": "فرعون وثمود",
    "page": 590
  },
  {
    "surah": "Al-Burooj",
    "ayah": 19,
    "text": "بل ٱلذین كفروا فی تكذیبࣲ",
    "page": 590
  },
  {
    "surah": "Al-Burooj",
    "ayah": 20,
    "text": "وٱلله من وراىٕهم محیط",
    "page": 590
  },
  {
    "surah": "Al-Burooj",
    "ayah": 21,
    "text": "بل هو قرءان مجید",
    "page": 590
  },
  {
    "surah": "Al-Burooj",
    "ayah": 22,
    "text": "فی لوحࣲ محفوظۭ",
    "page": 590
  }
]