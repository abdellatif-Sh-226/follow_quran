[
  {
    "surah": "At-Taariq",
    "ayah": 1,
    "text": "بسم ٱلله ٱلرحمـن ٱلرحیم وٱلسماء وٱلطارق",
    "page": 591
  },
  {
    "surah": "At-Taariq",
    "ayah": 2,
    "text": "وما أدرىك ما ٱلطارق",
    "page": 591
  },
  {
    "surah": "At-Taariq",
    "ayah": 3,
    "text": "ٱلنجم ٱلثاقب",
    "page": 591
  },
  {
    "surah": "At-Taariq",
    "ayah": 4,
    "text": "إن كل نفسࣲ لما علیها حافظ",
    "page": 591
  },
  {
    "surah": "At-Taariq",
    "ayah": 5,
    "text": "فلینظر ٱلإنسـن مم خلق",
    "page": 591
  },
  {
    "surah": "At-Taariq",
    "ayah": 6,
    "text": "خلق من ماءࣲ دافقࣲ",
    "page": 591
  },
  {
    "surah": "At-Taariq",
    "ayah": 7,
    "text": "یخرج من بین ٱلصلب وٱلتراىٕب",
    "page": 591
  },
  {
    "surah": "At-Taariq",
    "ayah": 8,
    "text": "إنه على رجعهۦ لقادر",
    "page": 591
  },
  {
    "surah": "At-Taariq",
    "ayah": 9,
    "text": "یوم تبلى ٱلسراىٕر",
    "page": 591
  },
  {
    "surah": "At-Taariq",
    "ayah": 10,
    "text": "فما له من قوةࣲ ولا ناصرࣲ",
    "page": 591
  },
  {
    "surah": "At-Taariq",
    "ayah": 11,
    "text": "وٱلسماء ذات ٱلرجع",
    "page": 591
  },
  {
    "surah": "At-Taariq",
    "ayah": 12,
    "text": "وٱلأرض ذات ٱلصدع",
    "page": 591
  },
  {
    "surah": "At-Taariq",
    "ayah": 13,
    "text": "إنه لقول فصل",
    "page": 591
  },
  {
    "surah": "At-Taariq",
    "ayah": 14,
    "text": "وما هو بٱلهزل",
    "page": 591
  },
  {
    "surah": "At-Taariq",
    "ayah": 15,
    "text": "إنهم یكیدون كیدا",
    "page": 591
  },
  {
    "surah": "At-Taariq",
    "ayah": 16,
    "text": "وأكید كیدا",
    "page": 591
  },
  {
    "surah": "At-Taariq",
    "ayah": 17,
    "text": "فمهل ٱلكـفرین أمهلهم رویدا",
    "page": 591
  }
]