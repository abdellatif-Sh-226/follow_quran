[
  {
    "surah": "Al-Qalam",
    "ayah": 1,
    "text": "بسم ٱلله ٱلرحمـن ٱلرحیم ن وٱلقلم وما یسطرون",
    "page": 564
  },
  {
    "surah": "Al-Qalam",
    "ayah": 2,
    "text": "ما أنت بنعمة ربك بمجنونࣲ",
    "page": 564
  },
  {
    "surah": "Al-Qalam",
    "ayah": 3,
    "text": "وإن لك لأجرا غیر ممنونࣲ",
    "page": 564
  },
  {
    "surah": "Al-Qalam",
    "ayah": 4,
    "text": "وإنك لعلى خلق عظیمࣲ",
    "page": 564
  },
  {
    "surah": "Al-Qalam",
    "ayah": 5,
    "text": "فستبصر ویبصرون",
    "page": 564
  },
  {
    "surah": "Al-Qalam",
    "ayah": 6,
    "text": "بأییكم ٱلمفتون",
    "page": 564
  },
  {
    "surah": "Al-Qalam",
    "ayah": 7,
    "text": "إن ربك هو أعلم بمن ضل عن سبیلهۦ وهو أعلم بٱلمهتدین",
    "page": 564
  },
  {
    "surah": "Al-Qalam",
    "ayah": 8,
    "text": "فلا تطع ٱلمكذبین",
    "page": 564
  },
  {
    "surah": "Al-Qalam",
    "ayah": 9,
    "text": "ودوا لو تدهن فیدهنون",
    "page": 564
  },
  {
    "surah": "Al-Qalam",
    "ayah": 10,
    "text": "ولا تطع كل حلافࣲ مهین",
    "page": 564
  },
  {
    "surah": "Al-Qalam",
    "ayah": 11,
    "text": "همازࣲ مشاءۭ بنمیمࣲ",
    "page": 564
  },
  {
    "surah": "Al-Qalam",
    "ayah": 12,
    "text": "مناعࣲ للخیر معتد أثیم",
    "page": 564
  },
  {
    "surah": "Al-Qalam",
    "ayah": 13,
    "text": "عتلۭ بعد ذ ⁠لك زنیم",
    "page": 564
  },
  {
    "surah": "Al-Qalam",
    "ayah": 14,
    "text": "أن كان ذا مالࣲ وبنین",
    "page": 564
  },
  {
    "surah": "Al-Qalam",
    "ayah": 15,
    "text": "إذا تتلى علیه ءایـتنا قال أسـطیر ٱلأولین",
    "page": 564
  },
  {
    "surah": "Al-Qalam",
    "ayah": 16,
    "text": "سنسمه على ٱلخرطوم",
    "page": 565
  },
  {
    "surah": "Al-Qalam",
    "ayah": 17,
    "text": "إنا بلونـهم كما بلونا أصحـب ٱلجنة إذ أقسموا لیصرمنها مصبحین",
    "page": 565
  },
  {
    "surah": "Al-Qalam",
    "ayah": 18,
    "text": "ولا یستثنون",
    "page": 565
  },
  {
    "surah": "Al-Qalam",
    "ayah": 19,
    "text": "فطاف علیها طاىٕف من ربك وهم ناىٕمون",
    "page": 565
  },
  {
    "surah": "Al-Qalam",
    "ayah": 20,
    "text": "فأصبحت كٱلصریم",
    "page": 565
  },
  {
    "surah": "Al-Qalam",
    "ayah": 21,
    "text": "فتنادوا مصبحین",
    "page": 565
  },
  {
    "surah": "Al-Qalam",
    "ayah": 22,
    "text": "أن ٱغدوا على حرثكم إن كنتم صـرمین",
    "page": 565
  },
  {
    "surah": "Al-Qalam",
    "ayah": 23,
    "text": "فٱنطلقوا وهم یتخـفتون",
    "page": 565
  },
  {
    "surah": "Al-Qalam",
    "ayah": 24,
    "text": "أن لا یدخلنها ٱلیوم علیكم مسكین",
    "page": 565
  },
  {
    "surah": "Al-Qalam",
    "ayah": 25,
    "text": "وغدوا على حردࣲ قـدرین",
    "page": 565
  },
  {
    "surah": "Al-Qalam",
    "ayah": 26,
    "text": "فلما رأوها قالوا إنا لضالون",
    "page": 565
  },
  {
    "surah": "Al-Qalam",
    "ayah": 27,
    "text": "بل نحن محرومون",
    "page": 565
  },
  {
    "surah": "Al-Qalam",
    "ayah": 28,
    "text": "قال أوسطهم ألم أقل لكم لولا تسبحون",
    "page": 565
  },
  {
    "surah": "Al-Qalam",
    "ayah": 29,
    "text": "قالوا سبحـن ربنا إنا كنا ظـلمین",
    "page": 565
  },
  {
    "surah": "Al-Qalam",
    "ayah": 30,
    "text": "فأقبل بعضهم على بعضࣲ یتلـومون",
    "page": 565
  },
  {
    "surah": "Al-Qalam",
    "ayah": 31,
    "text": "قالوا یـویلنا إنا كنا طـغین",
    "page": 565
  },
  {
    "surah": "Al-Qalam",
    "ayah": 32,
    "text": "عسى ربنا أن یبدلنا خیرا منها إنا إلى ربنا ر ⁠غبون",
    "page": 565
  },
  {
    "surah": "Al-Qalam",
    "ayah": 33,
    "text": "كذ ⁠لك ٱلعذاب ولعذاب ٱلـٔاخرة أكبر لو كانوا یعلمون",
    "page": 565
  },
  {
    "surah": "Al-Qalam",
    "ayah": 34,
    "text": "إن للمتقین عند ربهم جنـت ٱلنعیم",
    "page": 565
  },
  {
    "surah": "Al-Qalam",
    "ayah": 35,
    "text": "أفنجعل ٱلمسلمین كٱلمجرمین",
    "page": 565
  },
  {
    "surah": "Al-Qalam",
    "ayah": 36,
    "text": "ما لكم كیف تحكمون",
    "page": 565
  },
  {
    "surah": "Al-Qalam",
    "ayah": 37,
    "text": "أم لكم كتـب فیه تدرسون",
    "page": 565
  },
  {
    "surah": "Al-Qalam",
    "ayah": 38,
    "text": "إن لكم فیه لما تخیرون",
    "page": 565
  },
  {
    "surah": "Al-Qalam",
    "ayah": 39,
    "text": "أم لكم أیمـن علینا بـلغة إلى یوم ٱلقیـمة إن لكم لما تحكمون",
    "page": 565
  },
  {
    "surah": "Al-Qalam",
    "ayah": 40,
    "text": "سلهم أیهم بذ ⁠لك زعیم",
    "page": 565
  },
  {
    "surah": "Al-Qalam",
    "ayah": 41,
    "text": "أم لهم شركاء فلیأتوا بشركاىٕهم إن كانوا صـدقین",
    "page": 565
  },
  {
    "surah": "Al-Qalam",
    "ayah": 42,
    "text": "یوم یكشف عن ساقࣲ ویدعون إلى ٱلسجود فلا یستطیعون",
    "page": 565
  },
  {
    "surah": "Al-Qalam",
    "ayah": 43,
    "text": "خـشعة أبصـرهم ترهقهم ذلة وقد كانوا یدعون إلى ٱلسجود وهم سـلمون",
    "page": 566
  },
  {
    "surah": "Al-Qalam",
    "ayah": 44,
    "text": "فذرنی ومن یكذب بهـذا ٱلحدیث سنستدرجهم من حیث لا یعلمون",
    "page": 566
  },
  {
    "surah": "Al-Qalam",
    "ayah": 45,
    "text": "وأملی لهم إن كیدی متین",
    "page": 566
  },
  {
    "surah": "Al-Qalam",
    "ayah": 46,
    "text": "أم تسـٔلهم أجرا فهم من مغرمࣲ مثقلون",
    "page": 566
  },
  {
    "surah": "Al-Qalam",
    "ayah": 47,
    "text": "أم عندهم ٱلغیب فهم یكتبون",
    "page": 566
  },
  {
    "surah": "Al-Qalam",
    "ayah": 48,
    "text": "فٱصبر لحكم ربك ولا تكن كصاحب ٱلحوت إذ نادى وهو مكظوم",
    "page": 566
  },
  {
    "surah": "Al-Qalam",
    "ayah": 49,
    "text": "لولا أن تد ⁠ركه نعمة من ربهۦ لنبذ بٱلعراء وهو مذموم",
    "page": 566
  },
  {
    "surah": "Al-Qalam",
    "ayah": 50,
    "text": "فٱجتبـه ربه فجعله من ٱلصـلحین",
    "page": 566
  },
  {
    "surah": "Al-Qalam",
    "ayah": 51,
    "text": "وإن یكاد ٱلذین كفروا لیزلقونك بأبصـرهم لما سمعوا ٱلذكر ویقولون إنه لمجنون",
    "page": 566
  },
  {
    "surah": "Al-Qalam",
    "ayah": 52,
    "text": "وما هو إلا ذكر للعـلمین",
    "page": 566
  }
]