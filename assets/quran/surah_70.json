  {
    "surah": "Al-Ma'aarij",
    "ayah": 2,
    "text": "للكـفرین لیس له دافع",
    "page": 568
  },
  {
    "surah": "Al-Ma'aarij",
    "ayah": 3,
    "text": "من ٱلله ذی ٱلمعارج",
    "page": 568
  },
  {
    "surah": "Al-Ma'aarij",
    "ayah": 4,
    "text": "تعرج ٱلملـىٕكة وٱلروح إلیه فی یومࣲ كان مقداره خمسین ألف سنةࣲ",
    "page": 568
  },
  {
    "surah": "Al-Ma'aarij",
    "ayah": 5,
    "text": "فٱصبر صبرا جمیلا",
    "page": 568
  },
  {
    "surah": "Al-Ma'aarij",
    "ayah": 6,
    "text": "إنهم یرونه بعیدا",
    "page": 568
  },
  {
    "surah": "Al-Ma'aarij",
    "ayah": 7,
    "text": "ونرىه قریبا",
    "page": 568
  },
  {
    "surah": "Al-Ma'aarij",
    "ayah": 8,
    "text": "یوم تكون ٱلسماء كٱلمهل",
    "page": 568
  },
  {
    "surah": "Al-Ma'aarij",
    "ayah": 9,
    "text": "وتكون ٱلجبال كٱلعهن",
    "page": 568
  },
  {
    "surah": "Al-Ma'aarij",
    "ayah": 10,
    "text": "ولا یسـٔل حمیم حمیما",
    "page": 568
  },
  {
    "surah": "Al-Ma'aarij",
    "ayah": 11,
    "text": "یبصرونهم یود ٱلمجرم لو یفتدی من عذاب یومىٕذۭ ببنیه",
    "page": 569
  },
  {
    "surah": "Al-Ma'aarij",
    "ayah": 12,
    "text": "وصـحبتهۦ وأخیه",
    "page": 569
  },
  {
    "surah": "Al-Ma'aarij",
    "ayah": 13,
    "text": "وفصیلته ٱلتی تـٔویه",
    "page": 569
  },
  {
    "surah": "Al-Ma'aarij",
    "ayah": 14,
    "text": "ومن فی ٱلأرض جمیعا ثم ینجیه",
    "page": 569
  },
  {
    "surah": "Al-Ma'aarij",
    "ayah": 15,
    "text": "كلا إنها لظى",
    "page": 569
  },
  {
    "surah": "Al-Ma'aarij",
    "ayah": 16,
    "text": "نزاعة للشوى",
    "page": 569
  },
  {
    "surah": "Al-Ma'aarij",
    "ayah": 17,
    "text": "تدعوا من أدبر وتولى",
    "page": 569
  },
  {
    "surah": "Al-Ma'aarij",
    "ayah": 18,
    "text": "وجمع فأوعى",
    "page": 569
  },
  {
    "surah": "Al-Ma'aarij",
    "ayah": 19,
    "text": "۞ إن ٱلإنسـن خلق هلوعا",
    "page": 569
  },
  {
    "surah": "Al-Ma'aarij",
    "ayah": 20,
    "text": "إذا مسه ٱلشر جزوعا",
    "page": 569
  },
  {
    "surah": "Al-Ma'aarij",
    "ayah": 21,
    "text": "وإذا مسه ٱلخیر منوعا",
    "page": 569
  },
  {
    "surah": "Al-Ma'aarij",
    "ayah": 22,
    "text": "إلا ٱلمصلین",
    "page": 569
  },
  {
    "surah": "Al-Ma'aarij",
    "ayah": 23,
    "text": "ٱلذین هم على صلاتهم داىٕمون",
    "page": 569
  },
  {
    "surah": "Al-Ma'aarij",
    "ayah": 24,
    "text": "وٱلذین فی أمو ⁠لهم حق معلوم",
    "page": 569
  },
  {
    "surah": "Al-Ma'aarij",
    "ayah": 25,
    "text": "للساىٕل وٱلمحروم",
    "page": 569
  },
  {
    "surah": "Al-Ma'aarij",
    "ayah": 26,
    "text": "وٱلذین یصدقون بیوم ٱلدین",
    "page": 569
  },
  {
    "surah": "Al-Ma'aarij",
    "ayah": 27,
    "text": "وٱلذین هم من عذاب ربهم مشفقون",
    "page": 569
  },
  {
    "surah": "Al-Ma'aarij",
    "ayah": 28,
    "text": "إن عذاب ربهم غیر مأمونࣲ",
    "page": 569
  },
  {
    "surah": "Al-Ma'aarij",
    "ayah": 29,
    "text": "وٱلذین هم لفروجهم حـفظون",
    "page": 569
  },
  {
    "surah": "Al-Ma'aarij",
    "ayah": 30,
    "text": "إلا على أزو ⁠جهم أو ما ملكت أیمـنهم فإنهم غیر ملومین",
    "page": 569
  },
  {
    "surah": "Al-Ma'aarij",
    "ayah": 31,
    "text": "فمن ٱبتغى وراء ذ ⁠لك فأولـىٕك هم ٱلعادون",
    "page": 569
  },
  {
    "surah": "Al-Ma'aarij",
    "ayah": 32,
    "text": "وٱلذین هم لأمـنـتهم وعهدهم ر ⁠عون",
    "page": 569
  },
  {
    "surah": "Al-Ma'aarij",
    "ayah": 33,
    "text": "وٱلذین هم بشهـد ⁠تهم قاىٕمون",
    "page": 569
  },
  {
    "surah": "Al-Ma'aarij",
    "ayah": 34,
    "text": "وٱلذین هم على صلاتهم یحافظون",
    "page": 569
  },
  {
    "surah": "Al-Ma'aarij",
    "ayah": 35,
    "text": "أولـىٕك فی جنـتࣲ مكرمون",
    "page": 569
  },
  {
    "surah": "Al-Ma'aarij",
    "ayah": 36,
    "text": "فمال ٱلذین كفروا قبلك مهطعین",
    "page": 569
  },
  {
    "surah": "Al-Ma'aarij",
    "ayah": 37,
    "text": "عن ٱلیمین وعن ٱلشمال عزین",
    "page": 569
  },
  {
    "surah": "Al-Ma'aarij",
    "ayah": 38,
    "text": "أیطمع كل ٱمرئࣲ منهم أن یدخل جنة نعیمࣲ",
    "page": 569
  },
  {
    "surah": "Al-Ma'aarij",
    "ayah": 39,
    "text": "كلا إنا خلقنـهم مما یعلمون",
    "page": 569
  },
  {
    "surah": "Al-Ma'aarij",
    "ayah": 40,
    "text": "فلا أقسم برب ٱلمشـرق وٱلمغـرب إنا لقـدرون",
    "page": 570
  },
  {
    "surah": "Al-Ma'aarij",
    "ayah": 41,
    "text": "على أن نبدل خیرا منهم وما نحن بمسبوقین",
    "page": 570
  },
  {
    "surah": "Al-Ma'aarij",
    "ayah": 42,
    "text": "فذرهم یخوضوا ویلعبوا حتى یلـقوا یومهم ٱلذی یوعدون",
    "page": 570
  },
  {
    "surah": "Al-Ma'aarij",
    "ayah": 43,
    "text": "یوم یخرجون من ٱلأجداث سراعا كأنهم إلى نصبࣲ یوفضون",
    "page": 570
  },
  {
    "surah": "Al-Ma'aarij",
    "ayah": 44,
    "text": "خـشعة أبصـرهم ترهقهم ذلة ذ ⁠لك ٱلیوم ٱلذی كانوا یوعدون",
    "page": 570
  }
]