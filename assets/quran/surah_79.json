[
  {
    "surah": "An-Naazi'aat",
    "ayah": 1,
    "text": "بسم ٱلله ٱلرحمـن ٱلرحیم وٱلنـزعـت غرقا",
    "page": 583
  },
  {
    "surah": "An-Naazi'aat",
    "ayah": 2,
    "text": "وٱلنـشطـت نشطا",
    "page": 583
  },
  {
    "surah": "An-Naazi'aat",
    "ayah": 3,
    "text": "وٱلسـبحـت سبحا",
    "page": 583
  },
  {
    "surah": "An-Naazi'aat",
    "ayah": 4,
    "text": "فٱلسـبقـت سبقا",
    "page": 583
  },
  {
    "surah": "An-Naazi'aat",
    "ayah": 5,
    "text": "فٱلمدبر ⁠ت أمرا",
    "page": 583
  },
  {
    "surah": "An-Naazi'aat",
    "ayah": 6,
    "text": "یوم ترجف ٱلراجفة",
    "page": 583
  },
  {
    "surah": "An-Naazi'aat",
    "ayah": 7,
    "text": "تتبعها ٱلرادفة",
    "page": 583
  },
  {
    "surah": "An-Naazi'aat",
    "ayah": 8,
    "text": "قلوب یومىٕذࣲ واجفة",
    "page": 583
  },
  {
    "surah": "An-Naazi'aat",
    "ayah": 9,
    "text": "أبصـرها خـشعة",
    "page": 583
  },
  {
    "surah": "An-Naazi'aat",
    "ayah": 10,
    "text": "یقولون أءنا لمردودون فی ٱلحافرة",
    "page": 583
  },
  {
    "surah": "An-Naazi'aat",
    "ayah": 11,
    "text": "أءذا كنا عظـما نخرة",
    "page": 583
  },
  {
    "surah": "An-Naazi'aat",
    "ayah": 12,
    "text": "قالوا تلك إذا كرة خاسرة",
    "page": 583
  },
  {
    "surah": "An-Naazi'aat",
    "ayah": 13,
    "text": "فإنما هی زجرة و ⁠حدة",
    "page": 583
  },
  {
    "surah": "An-Naazi'aat",
    "ayah": 14,
    "text": "فإذا هم بٱلساهرة",
    "page": 583
  },
  {
    "surah": "An-Naazi'aat",
    "ayah": 15,
    "text": "هل أتىك حدیث موسى",
    "page": 583
  },
  {
    "surah": "An-Naazi'aat",
    "ayah": 16,
    "text": "إذ نادىه ربه بٱلواد ٱلمقدس طوى",
    "page": 584
  },
  {
    "surah": "An-Naazi'aat",
    "ayah": 17,
    "text": "ٱذهب إلى فرعون إنه طغى",
    "page": 584
  },
  {
    "surah": "An-Naazi'aat",
    "ayah": 18,
    "text": "فقل هل لك إلى أن تزكى",
    "page": 584
  },
  {
    "surah": "An-Naazi'aat",
    "ayah": 19,
    "text": "وأهدیك إلى ربك فتخشى",
    "page": 584
  },
  {
    "surah": "An-Naazi'aat",
    "ayah": 20,
    "text": "فأرىه ٱلـٔایة ٱلكبرى",
    "page": 584
  },
  {
    "surah": "An-Naazi'aat",
    "ayah": 21,
    "text": "فكذب وعصى",
    "page": 584
  },
  {
    "surah": "An-Naazi'aat",
    "ayah": 22,
    "text": "ثم أدبر یسعى",
    "page": 584
  },
  {
    "surah": "An-Naazi'aat",
    "ayah": 23,
    "text": "فحشر فنادى",
    "page": 584
  },
  {
    "surah": "An-Naazi'aat",
    "ayah": 24,
    "text": "فقال أنا۠ ربكم ٱلأعلى",
    "page": 584
  },
  {
    "surah": "An-Naazi'aat",
    "ayah": 25,
    "text": "فأخذه ٱلله نكال ٱلـٔاخرة وٱلأولى",
    "page": 584
  },
  {
    "surah": "An-Naazi'aat",
    "ayah": 26,
    "text": "إن فی ذ ⁠لك لعبرة لمن یخشى",
    "page": 584
  },
  {
    "surah": "An-Naazi'aat",
    "ayah": 27,
    "text": "ءأنتم أشد خلقا أم ٱلسماء بنىها",
    "page": 584
  },
  {
    "surah": "An-Naazi'aat",
    "ayah": 28,
    "text": "رفع سمكها فسوىها",
    "page": 584
  },
  {
    "surah": "An-Naazi'aat",
    "ayah": 29,
    "text": "وأغطش لیلها وأخرج ضحىها",
    "page": 584
  },
  {
    "surah": "An-Naazi'aat",
    "ayah": 30,
    "text": "وٱلأرض بعد ذ ⁠لك دحىها",
    "page": 584
  },
  {
    "surah": "An-Naazi'aat",
    "ayah": 31,
    "text": "أخرج منها ماءها ومرعىها",
    "page": 584
  },
  {
    "surah": "An-Naazi'aat",
    "ayah": 32,
    "text": "وٱلجبال أرسىها",
    "page": 584
  },
  {
    "surah": "An-Naazi'aat",
    "ayah": 33,
    "text": "متـعا لكم ولأنعـمكم",
    "page": 584
  },
  {
    "surah": "An-Naazi'aat",
    "ayah": 34,
    "text": "فإذا جاءت ٱلطامة ٱلكبرى",
    "page": 584
  },
  {
    "surah": "An-Naazi'aat",
    "ayah": 35,
    "text": "یوم یتذكر ٱلإنسـن ما سعى",
    "page": 584
  },
  {
    "surah": "An-Naazi'aat",
    "ayah": 36,
    "text": "وبرزت ٱلجحیم لمن یرى",
    "page": 584
  },
  {
    "surah": "An-Naazi'aat",
    "ayah": 37,
    "text": "فأما من طغى",
    "page": 584
  },
  {
    "surah": "An-Naazi'aat",
    "ayah": 38,
    "text": "وءاثر ٱلحیوة ٱلدنیا",
    "page": 584
  },
  {
    "surah": "An-Naazi'aat",
    "ayah": 39,
    "text": "فإن ٱلجحیم هی ٱلمأوى",
    "page": 584
  },
  {
    "surah": "An-Naazi'aat",
    "ayah": 40,
    "text": "وأما من خاف مقام ربهۦ ونهى ٱلنفس عن ٱلهوى",
    "page": 584
  },
  {
    "surah": "An-Naazi'aat",
    "ayah": 41,
    "text": "فإن ٱلجنة هی ٱلمأوى",
    "page": 584
  },
  {
    "surah": "An-Naazi'aat",
    "ayah": 42,
    "text": "یسـٔلونك عن ٱلساعة أیان مرسىها",
    "page": 584
  },
  {
    "surah": "An-Naazi'aat",
    "ayah": 43,
    "text": "فیم أنت من ذكرىها",
    "page": 584
  },
  {
    "surah": "An-Naazi'aat",
    "ayah": 44,
    "text": "إلى ربك منتهىها",
    "page": 584
  },
  {
    "surah": "An-Naazi'aat",
    "ayah": 45,
    "text": "إنما أنت منذر من یخشىها",
    "page": 584
  },
  {
    "surah": "An-Naazi'aat",
    "ayah": 46,
    "text": "كأنهم یوم یرونها لم یلبثوا إلا عشیة أو ضحىها",
    "page": 584
  }
]