[
  {
    "surah": "An-Najm",
    "ayah": 1,
    "text": "بسم ٱلله ٱلرحمـن ٱلرحیم وٱلنجم إذا هوى",
    "page": 526
  },
  {
    "surah": "An-Najm",
    "ayah": 2,
    "text": "ما ضل صاحبكم وما غوى",
    "page": 526
  },
  {
    "surah": "An-Najm",
    "ayah": 3,
    "text": "وما ینطق عن ٱلهوى",
    "page": 526
  },
  {
    "surah": "An-Najm",
    "ayah": 4,
    "text": "إن هو إلا وحی یوحى",
    "page": 526
  },
  {
    "surah": "An-Najm",
    "ayah": 5,
    "text": "علمه شدید ٱلقوى",
    "page": 526
  },
  {
    "surah": "An-Najm",
    "ayah": 6,
    "text": "ذو مرةࣲ فٱستوى",
    "page": 526
  },
  {
    "surah": "An-Najm",
    "ayah": 7,
    "text": "وهو بٱلأفق ٱلأعلى",
    "page": 526
  },
  {
    "surah": "An-Najm",
    "ayah": 8,
    "text": "ثم دنا فتدلى",
    "page": 526
  },
  {
    "surah": "An-Najm",
    "ayah": 9,
    "text": "فكان قاب قوسین أو أدنى",
    "page": 526
  },
  {
    "surah": "An-Najm",
    "ayah": 10,
    "text": "فأوحى إلى عبدهۦ ما أوحى",
    "page": 526
  },
  {
    "surah": "An-Najm",
    "ayah": 11,
    "text": "ما كذب ٱلفؤاد ما رأى",
    "page": 526
  },
  {
    "surah": "An-Najm",
    "ayah": 12,
    "text": "أفتمـرونه على ما یرى",
    "page": 526
  },
  {
    "surah": "An-Najm",
    "ayah": 13,
    "text": "ولقد رءاه نزلة أخرى",
    "page": 526
  },
  {
    "surah": "An-Najm",
    "ayah": 14,
    "text": "عند سدرة ٱلمنتهى",
    "page": 526
  },
  {
    "surah": "An-Najm",
    "ayah": 15,
    "text": "عندها جنة ٱلمأوى",
    "page": 526
  },
  {
    "surah": "An-Najm",
    "ayah": 16,
    "text": "إذ یغشى ٱلسدرة ما یغشى",
    "page": 526
  },
  {
    "surah": "An-Najm",
    "ayah": 17,
    "text": "ما زاغ ٱلبصر وما طغى",
    "page": 526
  },
  {
    "surah": "An-Najm",
    "ayah": 18,
    "text": "لقد رأى من ءایـت ربه ٱلكبرى",
    "page": 526
  },
  {
    "surah": "An-Najm",
    "ayah": 19,
    "text": "أفرءیتم ٱللـت وٱلعزى",
    "page": 526
  },
  {
    "surah": "An-Najm",
    "ayah": 20,
    "text": "ومنوة ٱلثالثة ٱلأخرى",
    "page": 526
  },
  {
    "surah": "An-Najm",
    "ayah": 21,
    "text": "ألكم ٱلذكر وله ٱلأنثى",
    "page": 526
  },
  {
    "surah": "An-Najm",
    "ayah": 22,
    "text": "تلك إذا قسمة ضیزى",
    "page": 526
  },
  {
    "surah": "An-Najm",
    "ayah": 23,
    "text": "إن هی إلا أسماء سمیتموها أنتم وءاباؤكم ما أنزل ٱلله بها من سلطـن إن یتبعون إلا ٱلظن وما تهوى ٱلأنفس ولقد جاءهم من ربهم ٱلهدى",
    "page": 526
  },
  {
    "surah": "An-Najm",
    "ayah": 24,
    "text": "أم للإنسـن ما تمنى",
    "page": 526
  },
  {
    "surah": "An-Najm",
    "ayah": 25,
    "text": "فلله ٱلـٔاخرة وٱلأولى",
    "page": 526
  },
  {
    "surah": "An-Najm",
    "ayah": 26,
    "text": "۞ وكم من ملكࣲ فی ٱلسمـو ⁠ت لا تغنی شفـعتهم شیـٔا إلا من بعد أن یأذن ٱلله لمن یشاء ویرضى",
    "page": 526
  },
  {
    "surah": "An-Najm",
    "ayah": 27,
    "text": "إن ٱلذین لا یؤمنون بٱلـٔاخرة لیسمون ٱلملـىٕكة تسمیة ٱلأنثى",
    "page": 527
  },
  {
    "surah": "An-Najm",
    "ayah": 28,
    "text": "وما لهم بهۦ من علم إن یتبعون إلا ٱلظن وإن ٱلظن لا یغنی من ٱلحق شیـٔا",
    "page": 527
  },
  {
    "surah": "An-Najm",
    "ayah": 29,
    "text": "فأعرض عن من تولى عن ذكرنا ولم یرد إلا ٱلحیوة ٱلدنیا",
    "page": 527
  },
  {
    "surah": "An-Najm",
    "ayah": 30,
    "text": "ذ ⁠لك مبلغهم من ٱلعلم إن ربك هو أعلم بمن ضل عن سبیلهۦ وهو أعلم بمن ٱهتدى",
    "page": 527
  },
  {
    "surah": "An-Najm",
    "ayah": 31,
    "text": "ولله ما فی ٱلسمـو ⁠ت وما فی ٱلأرض لیجزی ٱلذین أســٔوا بما عملوا ویجزی ٱلذین أحسنوا بٱلحسنى",
    "page": 527
  },
  {
    "surah": "An-Najm",
    "ayah": 32,
    "text": "ٱلذین یجتنبون كبـىٕر ٱلإثم وٱلفو ⁠حش إلا ٱللمم إن ربك و ⁠سع ٱلمغفرة هو أعلم بكم إذ أنشأكم من ٱلأرض وإذ أنتم أجنة فی بطون أمهـتكم فلا تزكوا أنفسكم هو أعلم بمن ٱتقى",
    "page": 527
  },
  {
    "surah": "An-Najm",
    "ayah": 33,
    "text": "أفرءیت ٱلذی تولى",
    "page": 527
  },
  {
    "surah": "An-Najm",
    "ayah": 34,
    "text": "وأعطى قلیلا وأكدى",
    "page": 527
  },
  {
    "surah": "An-Najm",
    "ayah": 35,
    "text": "أعنده علم ٱلغیب فهو یرى",
    "page": 527
  },
  {
    "surah": "An-Najm",
    "ayah": 36,
    "text": "أم لم ینبأ بما فی صحف موسى",
    "page": 527
  },
  {
    "surah": "An-Najm",
    "ayah": 37,
    "text": "وإبر ⁠هیم ٱلذی وفى",
    "page": 527
  },
  {
    "surah": "An-Najm",
    "ayah": 38,
    "text": "ألا تزر وازرة وزر أخرى",
    "page": 527
  },
  {
    "surah": "An-Najm",
    "ayah": 39,
    "text": "وأن لیس للإنسـن إلا ما سعى",
    "page": 527
  },
  {
    "surah": "An-Najm",
    "ayah": 40,
    "text": "وأن سعیه سوف یرى",
    "page": 527
  },
  {
    "surah": "An-Najm",
    "ayah": 41,
    "text": "ثم یجزىه ٱلجزاء ٱلأوفى",
    "page": 527
  },
  {
    "surah": "An-Najm",
    "ayah": 42,
    "text": "وأن إلى ربك ٱلمنتهى",
    "page": 527
  },
  {
    "surah": "An-Najm",
    "ayah": 43,
    "text": "وأنه هو أضحك وأبكى",
    "page": 527
  },
  {
    "surah": "An-Najm",
    "ayah": 44,
    "text": "وأنه هو أمات وأحیا",
    "page": 527
  },
  {
    "surah": "An-Najm",
    "ayah": 45,
    "text": "وأنه خلق ٱلزوجین ٱلذكر وٱلأنثى",
    "page": 528
  },
  {
    "surah": "An-Najm",
    "ayah": 46,
    "text": "من نطفة إذا تمنى",
    "page": 528
  },
  {
    "surah": "An-Najm",
    "ayah": 47,
    "text": "وأن علیه ٱلنشأة ٱلأخرى",
    "page": 528
  },
  {
    "surah": "An-Najm",
    "ayah": 48,
    "text": "وأنه هو أغنى وأقنى",
    "page": 528
  },
  {
    "surah": "An-Najm",
    "ayah": 49,
    "text": "وأنه هو رب ٱلشعرى",
    "page": 528
  },
  {
    "surah": "An-Najm",
    "ayah": 50,
    "text": "وأنه أهلك عادا ٱلأولى",
    "page": 528
  },
  {
    "surah": "An-Najm",
    "ayah": 51,
    "text": "وثمودا فما أبقى",
    "page": 528
  },
  {
    "surah": "An-Najm",
    "ayah": 52,
    "text": "وقوم نوحࣲ من قبل إنهم كانوا هم أظلم وأطغى",
    "page": 528
  },
  {
    "surah": "An-Najm",
    "ayah": 53,
    "text": "وٱلمؤتفكة أهوى",
    "page": 528
  },
  {
    "surah": "An-Najm",
    "ayah": 54,
    "text": "فغشىها ما غشى",
    "page": 528
  },
  {
    "surah": "An-Najm",
    "ayah": 55,
    "text": "فبأی ءالاء ربك تتمارى",
    "page": 528
  },
  {
    "surah": "An-Najm",
    "ayah": 56,
    "text": "هـذا نذیر من ٱلنذر ٱلأولى",
    "page": 528
  },
  {
    "surah": "An-Najm",
    "ayah": 57,
    "text": "أزفت ٱلـٔازفة",
    "page": 528
  },
  {
    "surah": "An-Najm",
    "ayah": 58,
    "text": "لیس لها من دون ٱلله كاشفة",
    "page": 528
  },
  {
    "surah": "An-Najm",
    "ayah": 59,
    "text": "أفمن هـذا ٱلحدیث تعجبون",
    "page": 528
  },
  {
    "surah": "An-Najm",
    "ayah": 60,
    "text": "وتضحكون ولا تبكون",
    "page": 528
  },
  {
    "surah": "An-Najm",
    "ayah": 61,
    "text": "وأنتم سـمدون",
    "page": 528
  },
  {
    "surah": "An-Najm",
    "ayah": 62,
    "text": "فٱسجدوا لله وٱعبدوا ۩",
    "page": 528
  }
]