[
  {
    "surah": "Al-Fajr",
    "ayah": 1,
    "text": "بسم ٱلله ٱلرحمـن ٱلرحیم وٱلفجر",
    "page": 593
  },
  {
    "surah": "Al-Fajr",
    "ayah": 2,
    "text": "ولیال عشرࣲ",
    "page": 593
  },
  {
    "surah": "Al-Fajr",
    "ayah": 3,
    "text": "وٱلشفع وٱلوتر",
    "page": 593
  },
  {
    "surah": "Al-Fajr",
    "ayah": 4,
    "text": "وٱلیل إذا یسر",
    "page": 593
  },
  {
    "surah": "Al-Fajr",
    "ayah": 5,
    "text": "هل فی ذ ⁠لك قسم لذی حجر",
    "page": 593
  },
  {
    "surah": "Al-Fajr",
    "ayah": 6,
    "text": "ألم تر كیف فعل ربك بعاد",
    "page": 593
  },
  {
    "surah": "Al-Fajr",
    "ayah": 7,
    "text": "إرم ذات ٱلعماد",
    "page": 593
  },
  {
    "surah": "Al-Fajr",
    "ayah": 8,
    "text": "ٱلتی لم یخلق مثلها فی ٱلبلـد",
    "page": 593
  },
  {
    "surah": "Al-Fajr",
    "ayah": 9,
    "text": "وثمود ٱلذین جابوا ٱلصخر بٱلواد",
    "page": 593
  },
  {
    "surah": "Al-Fajr",
    "ayah": 10,
    "text": "وفرعون ذی ٱلأوتاد",
    "page": 593
  },
  {
    "surah": "Al-Fajr",
    "ayah": 11,
    "text": "ٱلذین طغوا فی ٱلبلـد",
    "page": 593
  },
  {
    "surah": "Al-Fajr",
    "ayah": 12,
    "text": "فأكثروا فیها ٱلفساد",
    "page": 593
  },
  {
    "surah": "Al-Fajr",
    "ayah": 13,
    "text": "فصب علیهم ربك سوط عذاب",
    "page": 593
  },
  {
    "surah": "Al-Fajr",
    "ayah": 14,
    "text": "إن ربك لبٱلمرصاد",
    "page": 593
  },
  {
    "surah": "Al-Fajr",
    "ayah": 15,
    "text": "فأما ٱلإنسـن إذا ما ٱبتلىه ربه فأكرمه ونعمه فیقول ربی أكرمن",
    "page": 593
  },
  {
    "surah": "Al-Fajr",
    "ayah": 16,
    "text": "وأما إذا ما ٱبتلىه فقدر علیه رزقه فیقول ربی أهـنن",
    "page": 593
  },
  {
    "surah": "Al-Fajr",
    "ayah": 17,
    "text": "كلا بل لا تكرمون ٱلیتیم",
    "page": 593
  },
  {
    "surah": "Al-Fajr",
    "ayah": 18,
    "text": "ولا تحـضون على طعام ٱلمسكین",
    "page": 593
  },
  {
    "surah": "Al-Fajr",
    "ayah": 19,
    "text": "وتأكلون ٱلتراث أكلا لما",
    "page": 593
  },
  {
    "surah": "Al-Fajr",
    "ayah": 20,
    "text": "وتحبون ٱلمال حبا جما",
    "page": 593
  },
  {
    "surah": "Al-Fajr",
    "ayah": 21,
    "text": "كلا إذا دكت ٱلأرض دكا دكا",
    "page": 593
  },
  {
    "surah": "Al-Fajr",
    "ayah": 22,
    "text": "وجاء ربك وٱلملك صفا صفا",
    "page": 593
  },
  {
    "surah": "Al-Fajr",
    "ayah": 23,
    "text": "وجایء یومىٕذۭ بجهنم یومىٕذࣲ یتذكر ٱلإنسـن وأنى له ٱلذكرى",
    "page": 593
  },
  {
    "surah": "Al-Fajr",
    "ayah": 24,
    "text": "یقول یـلیتنی قدمت لحیاتی",
    "page": 594
  },
  {
    "surah": "Al-Fajr",
    "ayah": 25,
    "text": "فیومىٕذࣲ لا یعذب عذابه أحد",
    "page": 594
  },
  {
    "surah": "Al-Fajr",
    "ayah": 26,
    "text": "ولا یوثق وثاقه أحد",
    "page": 594
  },
  {
    "surah": "Al-Fajr",
    "ayah": 27,
    "text": "یـأیتها ٱلنفس ٱلمطمىٕنة",
    "page": 594
  },
  {
    "surah": "Al-Fajr",
    "ayah": 28,
    "text": "ٱرجعی إلى ربك راضیة مرضیة",
    "page": 594
  },
  {
    "surah": "Al-Fajr",
    "ayah": 29,
    "text": "فٱدخلی فی عبـدی",
    "page": 594
  },
  {
    "surah": "Al-Fajr",
    "ayah": 30,
    "text": "وٱدخلی جنتی",
    "page": 594
  }
]