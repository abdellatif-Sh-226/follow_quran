[
  {
    "surah": "Ad-Dukhaan",
    "ayah": 1,
    "text": "بسم ٱلله ٱلرحمـن ٱلرحیم حم",
    "page": 496
  },
  {
    "surah": "Ad-Dukhaan",
    "ayah": 2,
    "text": "وٱلكتـب ٱلمبین",
    "page": 496
  },
  {
    "surah": "Ad-Dukhaan",
    "ayah": 3,
    "text": "إنا أنزلنـه فی لیلةࣲ مبـركة إنا كنا منذرین",
    "page": 496
  },
  {
    "surah": "Ad-Dukhaan",
    "ayah": 4,
    "text": "فیها یفرق كل أمر حكیم",
    "page": 496
  },
  {
    "surah": "Ad-Dukhaan",
    "ayah": 5,
    "text": "أمرا من عندنا إنا كنا مرسلین",
    "page": 496
  },
  {
    "surah": "Ad-Dukhaan",
    "ayah": 6,
    "text": "رحمة من ربك إنه هو ٱلسمیع ٱلعلیم",
    "page": 496
  },
  {
    "surah": "Ad-Dukhaan",
    "ayah": 7,
    "text": "رب ٱلسمـو ⁠ت وٱلأرض وما بینهما إن كنتم موقنین",
    "page": 496
  },
  {
    "surah": "Ad-Dukhaan",
    "ayah": 8,
    "text": "لا إلـه إلا هو یحیۦ ویمیت ربكم ورب ءاباىٕكم ٱلأولین",
    "page": 496
  },
  {
    "surah": "Ad-Dukhaan",
    "ayah": 9,
    "text": "بل هم فی شكࣲ یلعبون",
    "page": 496
  },
  {
    "surah": "Ad-Dukhaan",
    "ayah": 10,
    "text": "فٱرتقب یوم تأتی ٱلسماء بدخانࣲ مبینࣲ",
    "page": 496
  },
  {
    "surah": "Ad-Dukhaan",
    "ayah": 11,
    "text": "یغشى ٱلناس هـذا عذاب ألیم",
    "page": 496
  },
  {
    "surah": "Ad-Dukhaan",
    "ayah": 12,
    "text": "ربنا ٱكشف عنا ٱلعذاب إنا مؤمنون",
    "page": 496
  },
  {
    "surah": "Ad-Dukhaan",
    "ayah": 13,
    "text": "أنى لهم ٱلذكرى وقد جاءهم رسول مبین",
    "page": 496
  },
  {
    "surah": "Ad-Dukhaan",
    "ayah": 14,
    "text": "ثم تولوا عنه وقالوا معلم مجنون",
    "page": 496
  },
  {
    "surah": "Ad-Dukhaan",
    "ayah": 15,
    "text": "إنا كاشفوا ٱلعذاب قلیلا إنكم عاىٕدون",
    "page": 496
  },
  {
    "surah": "Ad-Dukhaan",
    "ayah": 16,
    "text": "یوم نبطش ٱلبطشة ٱلكبرى إنا منتقمون",
    "page": 496
  },
  {
    "surah": "Ad-Dukhaan",
    "ayah": 17,
    "text": "۞ ولقد فتنا قبلهم قوم فرعون وجاءهم رسول كریم",
    "page": 496
  },
  {
    "surah": "Ad-Dukhaan",
    "ayah": 18,
    "text": "أن أدوا إلی عباد ٱلله إنی لكم رسول أمین",
    "page": 496
  },
  {
    "surah": "Ad-Dukhaan",
    "ayah": 19,
    "text": "وأن لا تعلوا على ٱلله إنی ءاتیكم بسلطـنࣲ مبینࣲ",
    "page": 497
  },
  {
    "surah": "Ad-Dukhaan",
    "ayah": 20,
    "text": "وإنی عذت بربی وربكم أن ترجمون",
    "page": 497
  },
  {
    "surah": "Ad-Dukhaan",
    "ayah": 21,
    "text": "وإن لم تؤمنوا لی فٱعتزلون",
    "page": 497
  },
  {
    "surah": "Ad-Dukhaan",
    "ayah": 22,
    "text": "فدعا ربه أن هـؤلاء قوم مجرمون",
    "page": 497
  },
  {
    "surah": "Ad-Dukhaan",
    "ayah": 23,
    "text": "فأسر بعبادی لیلا إنكم متبعون",
    "page": 497
  },
  {
    "surah": "Ad-Dukhaan",
    "ayah": 24,
    "text": "وٱترك ٱلبحر رهوا إنهم جند مغرقون",
    "page": 497
  },
  {
    "surah": "Ad-Dukhaan",
    "ayah": 25,
    "text": "كم تركوا من جنـتࣲ وعیونࣲ",
    "page": 497
  },
  {
    "surah": "Ad-Dukhaan",
    "ayah": 26,
    "text": "وزروعࣲ ومقامࣲ كریمࣲ",
    "page": 497
  },
  {
    "surah": "Ad-Dukhaan",
    "ayah": 27,
    "text": "ونعمةࣲ كانوا فیها فـكهین",
    "page": 497
  },
  {
    "surah": "Ad-Dukhaan",
    "ayah": 28,
    "text": "كذ ⁠لك وأورثنـها قوما ءاخرین",
    "page": 497
  },
  {
    "surah": "Ad-Dukhaan",
    "ayah": 29,
    "text": "فما بكت علیهم ٱلسماء وٱلأرض وما كانوا منظرین",
    "page": 497
  },
  {
    "surah": "Ad-Dukhaan",
    "ayah": 30,
    "text": "ولقد نجینا بنی إسر ⁠ءیل من ٱلعذاب ٱلمهین",
    "page": 497
  },
  {
    "surah": "Ad-Dukhaan",
    "ayah": 31,
    "text": "من فرعون إنه كان عالیا من ٱلمسرفین",
    "page": 497
  },
  {
    "surah": "Ad-Dukhaan",
    "ayah": 32,
    "text": "ولقد ٱخترنـهم على علم على ٱلعـلمین",
    "page": 497
  },
  {
    "surah": "Ad-Dukhaan",
    "ayah": 33,
    "text": "وءاتینـهم من ٱلـٔایـت ما فیه بلـؤا مبین",
    "page": 497
  },
  {
    "surah": "Ad-Dukhaan",
    "ayah": 34,
    "text": "إن هـؤلاء لیقولون",
    "page": 497
  },
  {
    "surah": "Ad-Dukhaan",
    "ayah": 35,
    "text": "إن هی إلا موتتنا ٱلأولى وما نحن بمنشرین",
    "page": 497
  },
  {
    "surah": "Ad-Dukhaan",
    "ayah": 36,
    "text": "فأتوا بـٔاباىٕنا إن كنتم صـدقین",
    "page": 497
  },
  {
    "surah": "Ad-Dukhaan",
    "ayah": 37,
    "text": "أهم خیر أم قوم تبعࣲ وٱلذین من قبلهم أهلكنـهم إنهم كانوا مجرمین",
    "page": 497
  },
  {
    "surah": "Ad-Dukhaan",
    "ayah": 38,
    "text": "وما خلقنا ٱلسمـو ⁠ت وٱلأرض وما بینهما لـعبین",
    "page": 497
  },
  {
    "surah": "Ad-Dukhaan",
    "ayah": 39,
    "text": "ما خلقنـهما إلا بٱلحق ولـكن أكثرهم لا یعلمون",
    "page": 497
  },
  {
    "surah": "Ad-Dukhaan",
    "ayah": 40,
    "text": "إن یوم ٱلفصل میقـتهم أجمعین",
    "page": 498
  },
  {
    "surah": "Ad-Dukhaan",
    "ayah": 41,
    "text": "یوم لا یغنی مولى عن مولى شیـٔا ولا هم ینصرون",
    "page": 498
  },
  {
    "surah": "Ad-Dukhaan",
    "ayah": 42,
    "text": "إلا من رحم ٱلله إنه هو ٱلعزیز ٱلرحیم",
    "page": 498
  },
  {
    "surah": "Ad-Dukhaan",
    "ayah": 43,
    "text": "إن شجرت ٱلزقوم",
    "page": 498
  },
  {
    "surah": "Ad-Dukhaan",
    "ayah": 44,
    "text": "طعام ٱلأثیم",
    "page": 498
  },
  {
    "surah": "Ad-Dukhaan",
    "ayah": 45,
    "text": "كٱلمهل یغلی فی ٱلبطون",
    "page": 498
  },
  {
    "surah": "Ad-Dukhaan",
    "ayah": 46,
    "text": "كغلی ٱلحمیم",
    "page": 498
  },
  {
    "surah": "Ad-Dukhaan",
    "ayah": 47,
    "text": "خذوه فٱعتلوه إلى سواء ٱلجحیم",
    "page": 498
  },
  {
    "surah": "Ad-Dukhaan",
    "ayah": 48,
    "text": "ثم صبوا فوق رأسهۦ من عذاب ٱلحمیم",
    "page": 498
  },
  {
    "surah": "Ad-Dukhaan",
    "ayah": 49,
    "text": "ذق إنك أنت ٱلعزیز ٱلكریم",
    "page": 498
  },
  {
    "surah": "Ad-Dukhaan",
    "ayah": 50,
    "text": "إن هـذا ما كنتم بهۦ تمترون",
    "page": 498
  },
  {
    "surah": "Ad-Dukhaan",
    "ayah": 51,
    "text": "إن ٱلمتقین فی مقام أمینࣲ",
    "page": 498
  },
  {
    "surah": "Ad-Dukhaan",
    "ayah": 52,
    "text": "فی جنـتࣲ وعیونࣲ",
    "page": 498
  },
  {
    "surah": "Ad-Dukhaan",
    "ayah": 53,
    "text": "یلبسون من سندسࣲ وإستبرقࣲ متقـبلین",
    "page": 498
  },
  {
    "surah": "Ad-Dukhaan",
    "ayah": 54,
    "text": "كذ ⁠لك وزوجنـهم بحور عینࣲ",
    "page": 498
  },
  {
    "surah": "Ad-Dukhaan",
    "ayah": 55,
    "text": "یدعون فیها بكل فـكهة ءامنین",
    "page": 498
  },
  {
    "surah": "Ad-Dukhaan",
    "ayah": 56,
    "text": "لا یذوقون فیها ٱلموت إلا ٱلموتة ٱلأولى ووقىهم عذاب ٱلجحیم",
    "page": 498
  },
  {
    "surah": "Ad-Dukhaan",
    "ayah": 57,
    "text": "فضلا من ربك ذ ⁠لك هو ٱلفوز ٱلعظیم",
    "page": 498
  },
  {
    "surah": "Ad-Dukhaan",
    "ayah": 58,
    "text": "فإنما یسرنـه بلسانك لعلهم یتذكرون",
    "page": 498
  },
  {
    "surah": "Ad-Dukhaan",
    "ayah": 59,
    "text": "فٱرتقب إنهم مرتقبون",
    "page": 498
  }
]