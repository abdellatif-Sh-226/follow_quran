[
  {
    "surah": "Al-Mutaffifin",
    "ayah": 1,
    "text": "بسم ٱلله ٱلرحمـن ٱلرحیم ویل للمطففین",
    "page": 587
  },
  {
    "surah": "Al-Mutaffifin",
    "ayah": 2,
    "text": "ٱلذین إذا ٱكتالوا على ٱلناس یستوفون",
    "page": 587
  },
  {
    "surah": "Al-Mutaffifin",
    "ayah": 3,
    "text": "وإذا كالوهم أو وزنوهم یخسرون",
    "page": 587
  },
  {
    "surah": "Al-Mutaffifin",
    "ayah": 4,
    "text": "ألا یظن أولـىٕك أنهم مبعوثون",
    "page": 587
  },
  {
    "surah": "Al-Mutaffifin",
    "ayah": 5,
    "text": "لیوم عظیمࣲ",
    "page": 587
  },
  {
    "surah": "Al-Mutaffifin",
    "ayah": 6,
    "text": "یوم یقوم ٱلناس لرب ٱلعـلمین",
    "page": 587
  },
  {
    "surah": "Al-Mutaffifin",
    "ayah": 7,
    "text": "كلا إن كتـب ٱلفجار لفی سجینࣲ",
    "page": 588
  },
  {
    "surah": "Al-Mutaffifin",
    "ayah": 8,
    "text": "وما أدرىك ما سجین",
    "page": 588
  },
  {
    "surah": "Al-Mutaffifin",
    "ayah": 9,
    "text": "كتـب مرقوم",
    "page": 588
  },
  {
    "surah": "Al-Mutaffifin",
    "ayah": 10,
    "text": "ویل یومىٕذࣲ للمكذبین",
    "page": 588
  },
  {
    "surah": "Al-Mutaffifin",
    "ayah": 11,
    "text": "ٱلذین یكذبون بیوم ٱلدین",
    "page": 588
  },
  {
    "surah": "Al-Mutaffifin",
    "ayah": 12,
    "text": "وما یكذب بهۦ إلا كل معتد أثیم",
    "page": 588
  },
  {
    "surah": "Al-Mutaffifin",
    "ayah": 13,
    "text": "إذا تتلى علیه ءایـتنا قال أسـطیر ٱلأولین",
    "page": 588
  },
  {
    "surah": "Al-Mutaffifin",
    "ayah": 14,
    "text": "كلا بل ران على قلوبهم ما كانوا یكسبون",
    "page": 588
  },
  {
    "surah": "Al-Mutaffifin",
    "ayah": 15,
    "text": "كلا إنهم عن ربهم یومىٕذࣲ لمحجوبون",
    "page": 588
  },
  {
    "surah": "Al-Mutaffifin",
    "ayah": 16,
    "text": "ثم إنهم لصالوا ٱلجحیم",
    "page": 588
  },
  {
    "surah": "Al-Mutaffifin",
    "ayah": 17,
    "text": "ثم یقال هـذا ٱلذی كنتم بهۦ تكذبون",
    "page": 588
  },
  {
    "surah": "Al-Mutaffifin",
    "ayah": 18,
    "text": "كلا إن كتـب ٱلأبرار لفی علیین",
    "page": 588
  },
  {
    "surah": "Al-Mutaffifin",
    "ayah": 19,
    "text": "وما أدرىك ما علیون",
    "page": 588
  },
  {
    "surah": "Al-Mutaffifin",
    "ayah": 20,
    "text": "كتـب مرقوم",
    "page": 588
  },
  {
    "surah": "Al-Mutaffifin",
    "ayah": 21,
    "text": "یشهده ٱلمقربون",
    "page": 588
  },
  {
    "surah": "Al-Mutaffifin",
    "ayah": 22,
    "text": "إن ٱلأبرار لفی نعیم",
    "page": 588
  },
  {
    "surah": "Al-Mutaffifin",
    "ayah": 23,
    "text": "على ٱلأراىٕك ینظرون",
    "page": 588
  },
  {
    "surah": "Al-Mutaffifin",
    "ayah": 24,
    "text": "تعرف فی وجوههم نضرة ٱلنعیم",
    "page": 588
  },
  {
    "surah": "Al-Mutaffifin",
    "ayah": 25,
    "text": "یسقون من رحیقࣲ مختوم",
    "page": 588
  },
  {
    "surah": "Al-Mutaffifin",
    "ayah": 26,
    "text": "ختـمه مسك وفی ذ ⁠لك فلیتنافس ٱلمتنـفسون",
    "page": 588
  },
  {
    "surah": "Al-Mutaffifin",
    "ayah": 27,
    "text": "ومزاجه من تسنیم",
    "page": 588
  },
  {
    "surah": "Al-Mutaffifin",
    "ayah": 28,
    "text": "عینا یشرب بها ٱلمقربون",
    "page": 588
  },
  {
    "surah": "Al-Mutaffifin",
    "ayah": 29,
    "text": "إن ٱلذین أجرموا كانوا من ٱلذین ءامنوا یضحكون",
    "page": 588
  },
  {
    "surah": "Al-Mutaffifin",
    "ayah": 30,
    "text": "وإذا مروا بهم یتغامزون",
    "page": 588
  },
  {
    "surah": "Al-Mutaffifin",
    "ayah": 31,
    "text": "وإذا ٱنقلبوا إلى أهلهم ٱنقلبوا فكهین",
    "page": 588
  },
  {
    "surah": "Al-Mutaffifin",
    "ayah": 32,
    "text": "وإذا رأوهم قالوا إن هـؤلاء لضالون",
    "page": 588
  },
  {
    "surah": "Al-Mutaffifin",
    "ayah": 33,
    "text": "وما أرسلوا علیهم حـفظین",
    "page": 588
  },
  {
    "surah": "Al-Mutaffifin",
    "ayah": 34,
    "text": "فٱلیوم ٱلذین ءامنوا من ٱلكفار یضحكون",
    "page": 588
  },
  {
    "surah": "Al-Mutaffifin",
    "ayah": 35,
    "text": "على ٱلأراىٕك ینظرون",
    "page": 589
  },
  {
    "surah": "Al-Mutaffifin",
    "ayah": 36,
    "text": "هل ثوب ٱلكفار ما كانوا یفعلون",
    "page": 589
  }
]