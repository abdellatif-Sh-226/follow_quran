[
  {
    "surah": "As-Saaffaat",
    "ayah": 1,
    "text": "بسم ٱلله ٱلرحمـن ٱلرحیم وٱلصـفـت صفا",
    "page": 446
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 2,
    "text": "فٱلز ⁠جر ⁠ت زجرا",
    "page": 446
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 3,
    "text": "فٱلتـلیـت ذكرا",
    "page": 446
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 4,
    "text": "إن إلـهكم لو ⁠حد",
    "page": 446
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 5,
    "text": "رب ٱلسمـو ⁠ت وٱلأرض وما بینهما ورب ٱلمشـرق",
    "page": 446
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 6,
    "text": "إنا زینا ٱلسماء ٱلدنیا بزینة ٱلكواكب",
    "page": 446
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 7,
    "text": "وحفظا من كل شیطـنࣲ ماردࣲ",
    "page": 446
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 8,
    "text": "لا یسمعون إلى ٱلملإ ٱلأعلى ویقذفون من كل جانبࣲ",
    "page": 446
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 9,
    "text": "دحورا ولهم عذاب واصب",
    "page": 446
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 10,
    "text": "إلا من خطف ٱلخطفة فأتبعه شهاب ثاقب",
    "page": 446
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 11,
    "text": "فٱستفتهم أهم أشد خلقا أم من خلقنا إنا خلقنـهم من طینࣲ لازبۭ",
    "page": 446
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 12,
    "text": "بل عجبت ویسخرون",
    "page": 446
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 13,
    "text": "وإذا ذكروا لا یذكرون",
    "page": 446
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 14,
    "text": "وإذا رأوا ءایة یستسخرون",
    "page": 446
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 15,
    "text": "وقالوا إن هـذا إلا سحر مبین",
    "page": 446
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 16,
    "text": "أءذا متنا وكنا ترابا وعظـما أءنا لمبعوثون",
    "page": 446
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 17,
    "text": "أوءاباؤنا ٱلأولون",
    "page": 446
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 18,
    "text": "قل نعم وأنتم د ⁠خرون",
    "page": 446
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 19,
    "text": "فإنما هی زجرة و ⁠حدة فإذا هم ینظرون",
    "page": 446
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 20,
    "text": "وقالوا یـویلنا هـذا یوم ٱلدین",
    "page": 446
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 21,
    "text": "هـذا یوم ٱلفصل ٱلذی كنتم بهۦ تكذبون",
    "page": 446
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 22,
    "text": "۞ ٱحشروا ٱلذین ظلموا وأزو ⁠جهم وما كانوا یعبدون",
    "page": 446
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 23,
    "text": "من دون ٱلله فٱهدوهم إلى صر ⁠ط ٱلجحیم",
    "page": 446
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 24,
    "text": "وقفوهم إنهم مسـٔولون",
    "page": 446
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 25,
    "text": "ما لكم لا تناصرون",
    "page": 447
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 26,
    "text": "بل هم ٱلیوم مستسلمون",
    "page": 447
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 27,
    "text": "وأقبل بعضهم على بعضࣲ یتساءلون",
    "page": 447
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 28,
    "text": "قالوا إنكم كنتم تأتوننا عن ٱلیمین",
    "page": 447
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 29,
    "text": "قالوا بل لم تكونوا مؤمنین",
    "page": 447
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 30,
    "text": "وما كان لنا علیكم من سلطـنۭ بل كنتم قوما طـغین",
    "page": 447
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 31,
    "text": "فحق علینا قول ربنا إنا لذاىٕقون",
    "page": 447
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 32,
    "text": "فأغوینـكم إنا كنا غـوین",
    "page": 447
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 33,
    "text": "فإنهم یومىٕذࣲ فی ٱلعذاب مشتركون",
    "page": 447
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 34,
    "text": "إنا كذ ⁠لك نفعل بٱلمجرمین",
    "page": 447
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 35,
    "text": "إنهم كانوا إذا قیل لهم لا إلـه إلا ٱلله یستكبرون",
    "page": 447
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 36,
    "text": "ویقولون أىٕنا لتاركوا ءالهتنا لشاعرࣲ مجنونۭ",
    "page": 447
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 37,
    "text": "بل جاء بٱلحق وصدق ٱلمرسلین",
    "page": 447
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 38,
    "text": "إنكم لذاىٕقوا ٱلعذاب ٱلألیم",
    "page": 447
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 39,
    "text": "وما تجزون إلا ما كنتم تعملون",
    "page": 447
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 40,
    "text": "إلا عباد ٱلله ٱلمخلصین",
    "page": 447
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 41,
    "text": "أولـىٕك لهم رزق معلوم",
    "page": 447
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 42,
    "text": "فو ⁠كه وهم مكرمون",
    "page": 447
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 43,
    "text": "فی جنـت ٱلنعیم",
    "page": 447
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 44,
    "text": "على سررࣲ متقـبلین",
    "page": 447
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 45,
    "text": "یطاف علیهم بكأسࣲ من معینۭ",
    "page": 447
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 46,
    "text": "بیضاء لذةࣲ للشـربین",
    "page": 447
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 47,
    "text": "لا فیها غول ولا هم عنها ینزفون",
    "page": 447
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 48,
    "text": "وعندهم قـصر ⁠ت ٱلطرف عین",
    "page": 447
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 49,
    "text": "كأنهن بیض مكنون",
    "page": 447
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 50,
    "text": "فأقبل بعضهم على بعضࣲ یتساءلون",
    "page": 447
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 51,
    "text": "قال قاىٕل منهم إنی كان لی قرین",
    "page": 447
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 52,
    "text": "یقول أءنك لمن ٱلمصدقین",
    "page": 448
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 53,
    "text": "أءذا متنا وكنا ترابا وعظـما أءنا لمدینون",
    "page": 448
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 54,
    "text": "قال هل أنتم مطلعون",
    "page": 448
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 55,
    "text": "فٱطلع فرءاه فی سواء ٱلجحیم",
    "page": 448
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 56,
    "text": "قال تٱلله إن كدت لتردین",
    "page": 448
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 57,
    "text": "ولولا نعمة ربی لكنت من ٱلمحضرین",
    "page": 448
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 58,
    "text": "أفما نحن بمیتین",
    "page": 448
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 59,
    "text": "إلا موتتنا ٱلأولى وما نحن بمعذبین",
    "page": 448
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 60,
    "text": "إن هـذا لهو ٱلفوز ٱلعظیم",
    "page": 448
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 61,
    "text": "لمثل هـذا فلیعمل ٱلعـملون",
    "page": 448
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 62,
    "text": "أذ ⁠لك خیر نزلا أم شجرة ٱلزقوم",
    "page": 448
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 63,
    "text": "إنا جعلنـها فتنة للظـلمین",
    "page": 448
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 64,
    "text": "إنها شجرة تخرج فی أصل ٱلجحیم",
    "page": 448
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 65,
    "text": "طلعها كأنه رءوس ٱلشیـطین",
    "page": 448
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 66,
    "text": "فإنهم لـٔاكلون منها فمالـٔون منها ٱلبطون",
    "page": 448
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 67,
    "text": "ثم إن لهم علیها لشوبا من حمیمࣲ",
    "page": 448
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 68,
    "text": "ثم إن مرجعهم لإلى ٱلجحیم",
    "page": 448
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 69,
    "text": "إنهم ألفوا ءاباءهم ضالین",
    "page": 448
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 70,
    "text": "فهم على ءاثـرهم یهرعون",
    "page": 448
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 71,
    "text": "ولقد ضل قبلهم أكثر ٱلأولین",
    "page": 448
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 72,
    "text": "ولقد أرسلنا فیهم منذرین",
    "page": 448
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 73,
    "text": "فٱنظر كیف كان عـقبة ٱلمنذرین",
    "page": 448
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 74,
    "text": "إلا عباد ٱلله ٱلمخلصین",
    "page": 448
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 75,
    "text": "ولقد نادىنا نوح فلنعم ٱلمجیبون",
    "page": 448
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 76,
    "text": "ونجینـه وأهله من ٱلكرب ٱلعظیم",
    "page": 448
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 77,
    "text": "وجعلنا ذریته هم ٱلباقین",
    "page": 449
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 78,
    "text": "وتركنا علیه فی ٱلـٔاخرین",
    "page": 449
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 79,
    "text": "سلـم على نوحࣲ فی ٱلعـلمین",
    "page": 449
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 80,
    "text": "إنا كذ ⁠لك نجزی ٱلمحسنین",
    "page": 449
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 81,
    "text": "إنه من عبادنا ٱلمؤمنین",
    "page": 449
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 82,
    "text": "ثم أغرقنا ٱلـٔاخرین",
    "page": 449
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 83,
    "text": "۞ وإن من شیعتهۦ لإبر ⁠هیم",
    "page": 449
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 84,
    "text": "إذ جاء ربه بقلبࣲ سلیم",
    "page": 449
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 85,
    "text": "إذ قال لأبیه وقومهۦ ماذا تعبدون",
    "page": 449
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 86,
    "text": "أىٕفكا ءالهة دون ٱلله تریدون",
    "page": 449
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 87,
    "text": "فما ظنكم برب ٱلعـلمین",
    "page": 449
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 88,
    "text": "فنظر نظرة فی ٱلنجوم",
    "page": 449
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 89,
    "text": "فقال إنی سقیم",
    "page": 449
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 90,
    "text": "فتولوا عنه مدبرین",
    "page": 449
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 91,
    "text": "فراغ إلى ءالهتهم فقال ألا تأكلون",
    "page": 449
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 92,
    "text": "ما لكم لا تنطقون",
    "page": 449
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 93,
    "text": "فراغ علیهم ضربا بٱلیمین",
    "page": 449
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 94,
    "text": "فأقبلوا إلیه یزفون",
    "page": 449
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 95,
    "text": "قال أتعبدون ما تنحتون",
    "page": 449
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 96,
    "text": "وٱلله خلقكم وما تعملون",
    "page": 449
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 97,
    "text": "قالوا ٱبنوا له بنیـنا فألقوه فی ٱلجحیم",
    "page": 449
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 98,
    "text": "فأرادوا بهۦ كیدا فجعلنـهم ٱلأسفلین",
    "page": 449
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 99,
    "text": "وقال إنی ذاهب إلى ربی سیهدین",
    "page": 449
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 100,
    "text": "رب هب لی من ٱلصـلحین",
    "page": 449
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 101,
    "text": "فبشرنـه بغلـم حلیمࣲ",
    "page": 449
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 102,
    "text": "فلما بلغ معه ٱلسعی قال یـبنی إنی أرى فی ٱلمنام أنی أذبحك فٱنظر ماذا ترى قال یـأبت ٱفعل ما تؤمر ستجدنی إن شاء ٱلله من ٱلصـبرین",
    "page": 449
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 103,
    "text": "فلما أسلما وتله للجبین",
    "page": 450
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 104,
    "text": "ونـدینـه أن یـإبر ⁠هیم",
    "page": 450
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 105,
    "text": "قد صدقت ٱلرءیا إنا كذ ⁠لك نجزی ٱلمحسنین",
    "page": 450
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 106,
    "text": "إن هـذا لهو ٱلبلـؤا ٱلمبین",
    "page": 450
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 107,
    "text": "وفدینـه بذبح عظیمࣲ",
    "page": 450
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 108,
    "text": "وتركنا علیه فی ٱلـٔاخرین",
    "page": 450
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 109,
    "text": "سلـم على إبر ⁠هیم",
    "page": 450
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 110,
    "text": "كذ ⁠لك نجزی ٱلمحسنین",
    "page": 450
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 111,
    "text": "إنه من عبادنا ٱلمؤمنین",
    "page": 450
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 112,
    "text": "وبشرنـه بإسحـق نبیا من ٱلصـلحین",
    "page": 450
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 113,
    "text": "وبـركنا علیه وعلى إسحـق ومن ذریتهما محسن وظالم لنفسهۦ مبین",
    "page": 450
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 114,
    "text": "ولقد مننا على موسى وهـرون",
    "page": 450
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 115,
    "text": "ونجینـهما وقومهما من ٱلكرب ٱلعظیم",
    "page": 450
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 116,
    "text": "ونصرنـهم فكانوا هم ٱلغـلبین",
    "page": 450
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 117,
    "text": "وءاتینـهما ٱلكتـب ٱلمستبین",
    "page": 450
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 118,
    "text": "وهدینـهما ٱلصر ⁠ط ٱلمستقیم",
    "page": 450
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 119,
    "text": "وتركنا علیهما فی ٱلـٔاخرین",
    "page": 450
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 120,
    "text": "سلـم على موسى وهـرون",
    "page": 450
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 121,
    "text": "إنا كذ ⁠لك نجزی ٱلمحسنین",
    "page": 450
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 122,
    "text": "إنهما من عبادنا ٱلمؤمنین",
    "page": 450
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 123,
    "text": "وإن إلیاس لمن ٱلمرسلین",
    "page": 450
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 124,
    "text": "إذ قال لقومهۦ ألا تتقون",
    "page": 450
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 125,
    "text": "أتدعون بعلا وتذرون أحسن ٱلخـلقین",
    "page": 450
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 126,
    "text": "ٱلله ربكم ورب ءاباىٕكم ٱلأولین",
    "page": 450
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 127,
    "text": "فكذبوه فإنهم لمحضرون",
    "page": 451
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 128,
    "text": "إلا عباد ٱلله ٱلمخلصین",
    "page": 451
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 129,
    "text": "وتركنا علیه فی ٱلـٔاخرین",
    "page": 451
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 130,
    "text": "سلـم على إل یاسین",
    "page": 451
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 131,
    "text": "إنا كذ ⁠لك نجزی ٱلمحسنین",
    "page": 451
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 132,
    "text": "إنه من عبادنا ٱلمؤمنین",
    "page": 451
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 133,
    "text": "وإن لوطا لمن ٱلمرسلین",
    "page": 451
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 134,
    "text": "إذ نجینـه وأهله أجمعین",
    "page": 451
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 135,
    "text": "إلا عجوزا فی ٱلغـبرین",
    "page": 451
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 136,
    "text": "ثم دمرنا ٱلـٔاخرین",
    "page": 451
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 137,
    "text": "وإنكم لتمرون علیهم مصبحین",
    "page": 451
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 138,
    "text": "وبٱلیل أفلا تعقلون",
    "page": 451
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 139,
    "text": "وإن یونس لمن ٱلمرسلین",
    "page": 451
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 140,
    "text": "إذ أبق إلى ٱلفلك ٱلمشحون",
    "page": 451
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 141,
    "text": "فساهم فكان من ٱلمدحضین",
    "page": 451
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 142,
    "text": "فٱلتقمه ٱلحوت وهو ملیم",
    "page": 451
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 143,
    "text": "فلولا أنه كان من ٱلمسبحین",
    "page": 451
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 144,
    "text": "للبث فی بطنهۦ إلى یوم یبعثون",
    "page": 451
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 145,
    "text": "۞ فنبذنـه بٱلعراء وهو سقیم",
    "page": 451
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 146,
    "text": "وأنبتنا علیه شجرة من یقطینࣲ",
    "page": 451
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 147,
    "text": "وأرسلنـه إلى مائة ألف أو یزیدون",
    "page": 451
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 148,
    "text": "فـٔامنوا فمتعنـهم إلى حینࣲ",
    "page": 451
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 149,
    "text": "فٱستفتهم ألربك ٱلبنات ولهم ٱلبنون",
    "page": 451
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 150,
    "text": "أم خلقنا ٱلملـىٕكة إنـثا وهم شـهدون",
    "page": 451
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 151,
    "text": "ألا إنهم من إفكهم لیقولون",
    "page": 451
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 152,
    "text": "ولد ٱلله وإنهم لكـذبون",
    "page": 451
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 153,
    "text": "أصطفى ٱلبنات على ٱلبنین",
    "page": 451
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 154,
    "text": "ما لكم كیف تحكمون",
    "page": 452
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 155,
    "text": "أفلا تذكرون",
    "page": 452
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 156,
    "text": "أم لكم سلطـن مبین",
    "page": 452
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 157,
    "text": "فأتوا بكتـبكم إن كنتم صـدقین",
    "page": 452
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 158,
    "text": "وجعلوا بینه وبین ٱلجنة نسبا ولقد علمت ٱلجنة إنهم لمحضرون",
    "page": 452
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 159,
    "text": "سبحـن ٱلله عما یصفون",
    "page": 452
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 160,
    "text": "إلا عباد ٱلله ٱلمخلصین",
    "page": 452
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 161,
    "text": "فإنكم وما تعبدون",
    "page": 452
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 162,
    "text": "ما أنتم علیه بفـتنین",
    "page": 452
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 163,
    "text": "إلا من هو صال ٱلجحیم",
    "page": 452
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 164,
    "text": "وما منا إلا له مقام معلوم",
    "page": 452
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 165,
    "text": "وإنا لنحن ٱلصافون",
    "page": 452
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 166,
    "text": "وإنا لنحن ٱلمسبحون",
    "page": 452
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 167,
    "text": "وإن كانوا لیقولون",
    "page": 452
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 168,
    "text": "لو أن عندنا ذكرا من ٱلأولین",
    "page": 452
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 169,
    "text": "لكنا عباد ٱلله ٱلمخلصین",
    "page": 452
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 170,
    "text": "فكفروا بهۦ فسوف یعلمون",
    "page": 452
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 171,
    "text": "ولقد سبقت كلمتنا لعبادنا ٱلمرسلین",
    "page": 452
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 172,
    "text": "إنهم لهم ٱلمنصورون",
    "page": 452
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 173,
    "text": "وإن جندنا لهم ٱلغـلبون",
    "page": 452
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 174,
    "text": "فتول عنهم حتى حینࣲ",
    "page": 452
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 175,
    "text": "وأبصرهم فسوف یبصرون",
    "page": 452
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 176,
    "text": "أفبعذابنا یستعجلون",
    "page": 452
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 177,
    "text": "فإذا نزل بساحتهم فساء صباح ٱلمنذرین",
    "page": 452
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 178,
    "text": "وتول عنهم حتى حینࣲ",
    "page": 452
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 179,
    "text": "وأبصر فسوف یبصرون",
    "page": 452
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 180,
    "text": "سبحـن ربك رب ٱلعزة عما یصفون",
    "page": 452
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 181,
    "text": "وسلـم على ٱلمرسلین",
    "page": 452
  },
  {
    "surah": "As-Saaffaat",
    "ayah": 182,
    "text": "وٱلحمد لله رب ٱلعـلمین",
    "page": 452
  }
]