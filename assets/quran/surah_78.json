  },
  {
    "surah": "An-Naba",
    "ayah": 34,
    "text": "وكأسا دهاقا",
    "page": 583
  },
  {
    "surah": "An-Naba",
    "ayah": 35,
    "text": "لا یسمعون فیها لغوا ولا كذ ⁠با",
    "page": 583
  },
  {
    "surah": "An-Naba",
    "ayah": 36,
    "text": "جزاء من ربك عطاء حسابا",
    "page": 583
  },
  {
    "surah": "An-Naba",
    "ayah": 37,
    "text": "رب ٱلسمـو ⁠ت وٱلأرض وما بینهما ٱلرحمـن لا یملكون منه خطابا",
    "page": 583
  },
  {
    "surah": "An-Naba",
    "ayah": 38,
    "text": "یوم یقوم ٱلروح وٱلملـىٕكة صفا لا یتكلمون إلا من أذن له ٱلرحمـن وقال صوابا",
    "page": 583
  },
  {
    "surah": "An-Naba",
    "ayah": 39,
    "text": "ذ ⁠لك ٱلیوم ٱلحق فمن شاء ٱتخذ إلى ربهۦ مـٔابا",
    "page": 583
  },
  {
    "surah": "An-Naba",
    "ayah": 40,
    "text": "إنا أنذرنـكم عذابا قریبا یوم ینظر ٱلمرء ما قدمت یداه ویقول ٱلكافر یـلیتنی كنت تر ⁠با",
    "page": 583
  }
