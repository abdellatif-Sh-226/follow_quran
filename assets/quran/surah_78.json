    "text": "یوم ینفخ فی ٱلصور فتأتون أفواجا",
    "page": 582
  },
  {
    "surah": "An-Naba",
    "ayah": 19,
    "text": "وفتحت ٱلسماء فكانت أبو ⁠با",
    "page": 582
  },
  {
    "surah": "An-Naba",
    "ayah": 20,
    "text": "وسیرت ٱلجبال فكانت سرابا",
    "page": 582
  },
  {
    "surah": "An-Naba",
    "ayah": 21,
    "text": "إن جهنم كانت مرصادا",
