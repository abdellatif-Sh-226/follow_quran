[
  {
    "surah": "Al-Qamar",
    "ayah": 1,
    "text": "بسم ٱلله ٱلرحمـن ٱلرحیم ٱقتربت ٱلساعة وٱنشق ٱلقمر",
    "page": 528
  },
  {
    "surah": "Al-Qamar",
    "ayah": 2,
    "text": "وإن یروا ءایة یعرضوا ویقولوا سحر مستمر",
    "page": 528
  },
  {
    "surah": "Al-Qamar",
    "ayah": 3,
    "text": "وكذبوا وٱتبعوا أهواءهم وكل أمرࣲ مستقر",
    "page": 528
  },
  {
    "surah": "Al-Qamar",
    "ayah": 4,
    "text": "ولقد جاءهم من ٱلأنباء ما فیه مزدجر",
    "page": 528
  },
  {
    "surah": "Al-Qamar",
    "ayah": 5,
    "text": "حكمة بـلغة فما تغن ٱلنذر",
    "page": 528
  },
  {
    "surah": "Al-Qamar",
    "ayah": 6,
    "text": "فتول عنهمۘ یوم یدع ٱلداع إلى شیءࣲ نكر",
    "page": 528
  },
  {
    "surah": "Al-Qamar",
    "ayah": 7,
    "text": "خشعا أبصـرهم یخرجون من ٱلأجداث كأنهم جراد منتشر",
    "page": 529
  },
  {
    "surah": "Al-Qamar",
    "ayah": 8,
    "text": "مهطعین إلى ٱلداع یقول ٱلكـفرون هـذا یوم عسر",
    "page": 529
  },
  {
    "surah": "Al-Qamar",
    "ayah": 9,
    "text": "۞ كذبت قبلهم قوم نوحࣲ فكذبوا عبدنا وقالوا مجنون وٱزدجر",
    "page": 529
  },
  {
    "surah": "Al-Qamar",
    "ayah": 10,
    "text": "فدعا ربه أنی مغلوب فٱنتصر",
    "page": 529
  },
  {
    "surah": "Al-Qamar",
    "ayah": 11,
    "text": "ففتحنا أبو ⁠ب ٱلسماء بماءࣲ منهمرࣲ",
    "page": 529
  },
  {
    "surah": "Al-Qamar",
    "ayah": 12,
    "text": "وفجرنا ٱلأرض عیونا فٱلتقى ٱلماء على أمرࣲ قد قدر",
    "page": 529
  },
  {
    "surah": "Al-Qamar",
    "ayah": 13,
    "text": "وحملنـه على ذات ألو ⁠حࣲ ودسرࣲ",
    "page": 529
  },
  {
    "surah": "Al-Qamar",
    "ayah": 14,
    "text": "تجری بأعیننا جزاء لمن كان كفر",
    "page": 529
  },
  {
    "surah": "Al-Qamar",
    "ayah": 15,
    "text": "ولقد تركنـها ءایة فهل من مدكرࣲ",
    "page": 529
  },
  {
    "surah": "Al-Qamar",
    "ayah": 16,
    "text": "فكیف كان عذابی ونذر",
    "page": 529
  },
  {
    "surah": "Al-Qamar",
    "ayah": 17,
    "text": "ولقد یسرنا ٱلقرءان للذكر فهل من مدكرࣲ",
    "page": 529
  },
  {
    "surah": "Al-Qamar",
    "ayah": 18,
    "text": "كذبت عاد فكیف كان عذابی ونذر",
    "page": 529
  },
  {
    "surah": "Al-Qamar",
    "ayah": 19,
    "text": "إنا أرسلنا علیهم ریحا صرصرا فی یوم نحسࣲ مستمرࣲ",
    "page": 529
  },
  {
    "surah": "Al-Qamar",
    "ayah": 20,
    "text": "تنزع ٱلناس كأنهم أعجاز نخلࣲ منقعرࣲ",
    "page": 529
  },
  {
    "surah": "Al-Qamar",
    "ayah": 21,
    "text": "فكیف كان عذابی ونذر",
    "page": 529
  },
  {
    "surah": "Al-Qamar",
    "ayah": 22,
    "text": "ولقد یسرنا ٱلقرءان للذكر فهل من مدكرࣲ",
    "page": 529
  },
  {
    "surah": "Al-Qamar",
    "ayah": 23,
    "text": "كذبت ثمود بٱلنذر",
    "page": 529
  },
  {
    "surah": "Al-Qamar",
    "ayah": 24,
    "text": "فقالوا أبشرا منا و ⁠حدا نتبعه إنا إذا لفی ضلـلࣲ وسعر",
    "page": 529
  },
  {
    "surah": "Al-Qamar",
    "ayah": 25,
    "text": "أءلقی ٱلذكر علیه من بیننا بل هو كذاب أشر",
    "page": 529
  },
  {
    "surah": "Al-Qamar",
    "ayah": 26,
    "text": "سیعلمون غدا من ٱلكذاب ٱلأشر",
    "page": 529
  },
  {
    "surah": "Al-Qamar",
    "ayah": 27,
    "text": "إنا مرسلوا ٱلناقة فتنة لهم فٱرتقبهم وٱصطبر",
    "page": 529
  },
  {
    "surah": "Al-Qamar",
    "ayah": 28,
    "text": "ونبئهم أن ٱلماء قسمة بینهم كل شربࣲ محتضر",
    "page": 530
  },
  {
    "surah": "Al-Qamar",
    "ayah": 29,
    "text": "فنادوا صاحبهم فتعاطى فعقر",
    "page": 530
  },
  {
    "surah": "Al-Qamar",
    "ayah": 30,
    "text": "فكیف كان عذابی ونذر",
    "page": 530
  },
  {
    "surah": "Al-Qamar",
    "ayah": 31,
    "text": "إنا أرسلنا علیهم صیحة و ⁠حدة فكانوا كهشیم ٱلمحتظر",
    "page": 530
  },
  {
    "surah": "Al-Qamar",
    "ayah": 32,
    "text": "ولقد یسرنا ٱلقرءان للذكر فهل من مدكرࣲ",
    "page": 530
  },
  {
    "surah": "Al-Qamar",
    "ayah": 33,
    "text": "كذبت قوم لوطۭ بٱلنذر",
    "page": 530
  },
  {
    "surah": "Al-Qamar",
    "ayah": 34,
    "text": "إنا أرسلنا علیهم حاصبا إلا ءال لوطࣲ نجینـهم بسحرࣲ",
    "page": 530
  },
  {
    "surah": "Al-Qamar",
    "ayah": 35,
    "text": "نعمة من عندنا كذ ⁠لك نجزی من شكر",
    "page": 530
  },
  {
    "surah": "Al-Qamar",
    "ayah": 36,
    "text": "ولقد أنذرهم بطشتنا فتماروا بٱلنذر",
    "page": 530
  },
  {
    "surah": "Al-Qamar",
    "ayah": 37,
    "text": "ولقد ر ⁠ودوه عن ضیفهۦ فطمسنا أعینهم فذوقوا عذابی ونذر",
    "page": 530
  },
  {
    "surah": "Al-Qamar",
    "ayah": 38,
    "text": "ولقد صبحهم بكرة عذاب مستقر",
    "page": 530
  },
  {
    "surah": "Al-Qamar",
    "ayah": 39,
    "text": "فذوقوا عذابی ونذر",
    "page": 530
  },
  {
    "surah": "Al-Qamar",
    "ayah": 40,
    "text": "ولقد یسرنا ٱلقرءان للذكر فهل من مدكرࣲ",
    "page": 530
  },
  {
    "surah": "Al-Qamar",
    "ayah": 41,
    "text": "ولقد جاء ءال فرعون ٱلنذر",
    "page": 530
  },
  {
    "surah": "Al-Qamar",
    "ayah": 42,
    "text": "كذبوا بـٔایـتنا كلها فأخذنـهم أخذ عزیزࣲ مقتدر",
    "page": 530
  },
  {
    "surah": "Al-Qamar",
    "ayah": 43,
    "text": "أكفاركم خیر من أولـىٕكم أم لكم براءة فی ٱلزبر",
    "page": 530
  },
  {
    "surah": "Al-Qamar",
    "ayah": 44,
    "text": "أم یقولون نحن جمیع منتصر",
    "page": 530
  },
  {
    "surah": "Al-Qamar",
    "ayah": 45,
    "text": "سیهزم ٱلجمع ویولون ٱلدبر",
    "page": 530
  },
  {
    "surah": "Al-Qamar",
    "ayah": 46,
    "text": "بل ٱلساعة موعدهم وٱلساعة أدهى وأمر",
    "page": 530
  },
  {
    "surah": "Al-Qamar",
    "ayah": 47,
    "text": "إن ٱلمجرمین فی ضلـلࣲ وسعرࣲ",
    "page": 530
  },
  {
    "surah": "Al-Qamar",
    "ayah": 48,
    "text": "یوم یسحبون فی ٱلنار على وجوههم ذوقوا مس سقر",
    "page": 530
  },
  {
    "surah": "Al-Qamar",
    "ayah": 49,
    "text": "إنا كل شیء خلقنـه بقدرࣲ",
    "page": 530
  },
  {
    "surah": "Al-Qamar",
    "ayah": 50,
    "text": "وما أمرنا إلا و ⁠حدة كلمحۭ بٱلبصر",
    "page": 531
  },
  {
    "surah": "Al-Qamar",
    "ayah": 51,
    "text": "ولقد أهلكنا أشیاعكم فهل من مدكرࣲ",
    "page": 531
  },
  {
    "surah": "Al-Qamar",
    "ayah": 52,
    "text": "وكل شیءࣲ فعلوه فی ٱلزبر",
    "page": 531
  },
  {
    "surah": "Al-Qamar",
    "ayah": 53,
    "text": "وكل صغیرࣲ وكبیرࣲ مستطر",
    "page": 531
  },
  {
    "surah": "Al-Qamar",
    "ayah": 54,
    "text": "إن ٱلمتقین فی جنـتࣲ ونهرࣲ",
    "page": 531
  },
  {
    "surah": "Al-Qamar",
    "ayah": 55,
    "text": "فی مقعد صدق عند ملیكࣲ مقتدرۭ",
    "page": 531
  }
]